{
  "name": "cliver-playbook",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "description": "Engineering asset library: composable backend and frontend packages, plus the skills that assemble them into a project.",
  "scripts": {
    "dev": "pnpm --filter cliver-playbook-dev-basic dev",
    "dev:user": "pnpm --filter cliver-playbook-dev-user dev",
    "dev:rag": "pnpm --filter cliver-playbook-dev-rag dev",
    "dev:mcp": "pnpm --filter cliver-playbook-dev-mcp dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  }
}
