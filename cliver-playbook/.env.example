# Optional overrides — every variable below already has a working default (see
# app.yaml at the repository root, and the Settings classes it feeds). Copy to
# .env to change values; the real .env is gitignored and never committed.
#
# Resolution order (highest first): environment > this .env file > app.yaml
# (Jinja2-rendered) > field defaults in the packages' settings modules.
# app.yaml keys are bare field names WITHOUT the CLIVER_ prefix; the Settings
# classes are the structure authority for both layers.

# PostgreSQL connection string in canonical postgresql:// form. The default
# matches the bundled docker-compose db (make db-up), so local development
# needs no .env at all. Each package derives the async (asyncpg) and sync
# (psycopg, Alembic-only) URLs from this single value.
CLIVER_DATABASE_URL=postgresql://cliver:cliver@127.0.0.1:5432/cliver_app

# Application display name (FastAPI title, frontend branding).
CLIVER_APP_NAME=cliver-app

# Log level for the backend (DEBUG / INFO / WARNING / ERROR).
CLIVER_LOG_LEVEL=INFO

# Optional: a different YAML config location (defaults to the nearest app.yaml
# walking up from the working directory). Pointing this at a missing file is a
# hard startup error, not a silent fallback.
#CLIVER_CONFIG_FILE=/etc/cliver-app/app.yaml

# app.yaml composes database_url from these parts, each defaulting to the
# bundled compose db. CLIVER_DATABASE_URL above sits in a higher layer and wins
# over the composed value when set.
#CLIVER_DB_USER=cliver
#CLIVER_DB_PASSWORD=cliver
#CLIVER_DB_HOST=127.0.0.1
#CLIVER_DB_PORT=5432
#CLIVER_DB_NAME=cliver_app

# ---------------------------------------------------------------------------
# Identity domain (cliver-playbook-app-user)
# ---------------------------------------------------------------------------

# HMAC key for signed blobs (OIDC state cookies, OAuth login tickets).
# Empty -> derived from the database URL (fine for dev; set explicitly in
# production so rotating the database does not invalidate outstanding blobs).
CLIVER_SECRET_KEY=

# Initial admin password, read by the migration seed exactly once.
# Empty -> a random password is generated and printed once in the migration
# output; the first login forces a change either way.
CLIVER_INITIAL_ADMIN_PASSWORD=

# Web session token lifetime in days. Static and OAuth tokens have their own
# rules (see the identity package's auth/tokens.py, ADR-0004).
CLIVER_TOKEN_TTL_DAYS=30

# Brute-force lockout: failed logins before the account locks, and the lock
# window in minutes.
CLIVER_LOGIN_LOCKOUT_THRESHOLD=5
CLIVER_LOGIN_LOCKOUT_MINUTES=15

# Absolute base URL of the frontend SPA. The backend redirects here after OIDC
# login, handing the session token over in the URL fragment.
CLIVER_WEB_BASE_URL=http://127.0.0.1:5173

# --- OIDC login (the app as a client of external identity providers) ---
# Providers form a nested registry; app.yaml ships presets (both disabled).
# Environment overrides use "__" nesting and merge over the YAML entries;
# provider keys match case-insensitively. An enabled provider must carry
# client_id + client_secret plus either an issuer (OIDC discovery) or all
# three explicit endpoint URLs — validated at startup, fail fast.
#CLIVER_OIDC__PROVIDERS__GOOGLE__ENABLED=true
#CLIVER_OIDC__PROVIDERS__GOOGLE__CLIENT_ID=
#CLIVER_OIDC__PROVIDERS__GOOGLE__CLIENT_SECRET=
# Absolute base URL of THIS backend as the provider sees it; the callback
# registered with each provider is <base>/api/v1/auth/oauth/<provider>/callback.
# Empty -> derived from the incoming request.
#CLIVER_OIDC__REDIRECT_BASE=

# --- OAuth 2.1 provider (AI-agent / API clients, ADR-0005) ---
# Switch the whole provider surface off when no agent clients will connect.
CLIVER_OAUTH21_ENABLED=true
# External base URL of this service as agents reach it — the `iss` value. Set it
# explicitly behind proxies that rewrite Host: `iss` must match the URL the
# client used byte-for-byte. Empty -> derived per request.
CLIVER_OAUTH21_ISSUER_URL=
CLIVER_OAUTH21_ACCESS_TTL_SECONDS=3600
CLIVER_OAUTH21_REFRESH_TTL_SECONDS=2592000
CLIVER_OAUTH21_CODE_TTL_SECONDS=300
CLIVER_OAUTH21_LOGIN_TTL_SECONDS=600
# Refresh-replay grace window: replays inside it are audited as network retries
# instead of revoking the whole token family.
CLIVER_OAUTH21_REPLAY_GRACE_SECONDS=30

# ---------------------------------------------------------------------------
# RAG pipeline (cliver-playbook-app-rag)
# ---------------------------------------------------------------------------

# app.yaml pins the offline stages (stub embedder, noop reranker, stub
# generator) so a fresh clone works without model downloads. Uncomment to use
# the production stages; both download weights on first use. Any registered
# name from GET /api/v1/rag/stages is valid.
#CLIVER_RAG__EMBEDDER=bge-m3
#CLIVER_RAG__RERANKER=bge-reranker-v2-m3
#CLIVER_RAG__CHUNKER=recursive
#CLIVER_RAG__RETRIEVER=pgvector-hybrid
#CLIVER_RAG__LLM=stub

# The query embedder must match the model that indexed the documents; the
# chat page exposes that choice per request, so this is only the default.
# Vectors from different embedders are not comparable.

# Chunking defaults for uploads that do not name a size.
#CLIVER_RAG__CHUNK_SIZE=512
#CLIVER_RAG__CHUNK_OVERLAP=64

# Retrieval bounds and chat relevance floor. The floor applies only to
# rerankers that emit normalized relevance scores (the noop reranker skips
# it). pgvector HNSW search breadth is per query, not per index.
#CLIVER_RAG__TOP_K=20
#CLIVER_RAG__RERANK_TOP_K=5
#CLIVER_RAG__SCORE_FLOOR=0.2
#CLIVER_RAG__PGVECTOR_EF_SEARCH=40

# ---------------------------------------------------------------------------
# MCP server (cliver-playbook-app-mcp)
# ---------------------------------------------------------------------------

# Auth gate for /mcp. Default false = no credential required, and calls run as
# an ANONYMOUS viewer: tools marked public answer, permission-gated tools are
# denied. Set true to require a Bearer token on every /mcp request — any token
# from the shared auth_tokens table works (Web session, static token, OAuth
# access token). Turn this on before exposing /mcp beyond the loopback.
#CLIVER_MCP__AUTH_ENABLED=true

# Public path of the MCP endpoint (exact-match route; no trailing slash).
#CLIVER_MCP__MOUNT_PATH=/mcp

# Concurrency cap: tool calls executed at once per process (queueing, not
# rejection).
#CLIVER_MCP__MAX_CONCURRENT_CALLS=16

# Agent self-identification. HTTP callers may send X-MCP-Agent-Type /
# X-MCP-Agent-Id headers; both land in the audit row. Values outside the
# whitelist are recorded as "unknown". An empty list accepts any string.
#CLIVER_MCP__AGENT_TYPE_WHITELIST=["claude-code","workbuddy","codex","mcp-cli","web-playground","unknown"]
#CLIVER_MCP__AGENT_ID_MAX_LENGTH=128

# stdio transport identity (`make mcp-stdio`): environment-variable equivalents
# of the HTTP headers above. NOTE: the stdio bootstrap reads these from the
# PROCESS environment directly — they are NOT read from this .env file (that is
# deliberate: env is the only channel an agent can hand to a child process).
# With CLIVER_MCP__AUTH_ENABLED=true, MCP_BEARER_TOKEN is required and the
# process refuses to start without it.
#MCP_BEARER_TOKEN=
#MCP_AGENT_TYPE=claude-code
#MCP_AGENT_ID=
