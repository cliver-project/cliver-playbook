# Optional overrides — every variable already has a working default (see
# backend/app/core/config.py). Copy to .env to change values; never commit
# the real .env file.

# PostgreSQL connection string in canonical postgresql:// form. The default
# matches the bundled docker-compose db (make db-up), so local development
# needs no .env at all. The app derives the async (asyncpg) and sync
# (psycopg, Alembic-only) URLs from this single value.
CLIVER_DATABASE_URL=postgresql://cliver:cliver@127.0.0.1:5432/cliver_app

# Application display name (FastAPI title, frontend branding).
CLIVER_APP_NAME=cliver-app

# Log level for the backend (DEBUG / INFO / WARNING / ERROR).
CLIVER_LOG_LEVEL=INFO

# --- Configuration layers ---------------------------------------------------
# Resolution order (highest first): environment > this .env file > app.yaml
# (project root, Jinja2-rendered) > field defaults in backend/app/core/
# config.py. app.yaml keys are bare field names WITHOUT the CLIVER_ prefix;
# the Settings class is the structure authority for both layers.
#
# Optional: use a different YAML config location (defaults to <root>/app.yaml;
# pointing this at a missing file is a hard startup error, not a fallback).
#CLIVER_CONFIG_FILE=/etc/cliver-app/app.yaml
#
# The checked-in app.yaml composes database_url from these parts, each
# defaulting to the bundled compose db. CLIVER_DATABASE_URL above sits in a
# higher layer and wins over the composed value when set.
#CLIVER_DB_USER=cliver
#CLIVER_DB_PASSWORD=cliver
#CLIVER_DB_HOST=127.0.0.1
#CLIVER_DB_PORT=5432
#CLIVER_DB_NAME=cliver_app

# ---------------------------------------------------------------------------
# Identity domain (user-management template)
# ---------------------------------------------------------------------------

# HMAC key for signed blobs (OIDC state cookies, OAuth login tickets).
# Empty -> derived from the database URL (fine for dev; set explicitly in
# production so rotating the database does not invalidate outstanding blobs).
CLIVER_SECRET_KEY=

# Initial admin password, read by the migration seed exactly once.
# Empty -> a random password is generated and printed once in the migration
# output; the first login forces a change either way.
CLIVER_INITIAL_ADMIN_PASSWORD=

# Web session token lifetime in days. Static and OAuth tokens have their own
# rules (see backend/app/auth/tokens.py).
CLIVER_TOKEN_TTL_DAYS=30

# Brute-force lockout: failed logins before the account locks, and the lock
# window in minutes.
CLIVER_LOGIN_LOCKOUT_THRESHOLD=5
CLIVER_LOGIN_LOCKOUT_MINUTES=15

# Absolute base URL of the frontend SPA. The backend redirects here after
# OIDC login, handing the session token over in the URL fragment.
CLIVER_WEB_BASE_URL=http://127.0.0.1:5173

# --- OIDC client (login via external identity providers) ---
# Providers form a nested registry: the checked-in app.yaml ships Google and
# GitHub presets (both disabled). Environment overrides use "__" nesting and
# merge over the YAML entries; provider keys match case-insensitively. An
# enabled provider must carry client_id + client_secret plus either an
# issuer (OIDC discovery) or all three explicit endpoint URLs — validated at
# startup, fail fast.
#CLIVER_OIDC__PROVIDERS__GOOGLE__ENABLED=true
#CLIVER_OIDC__PROVIDERS__GOOGLE__CLIENT_ID=
#CLIVER_OIDC__PROVIDERS__GOOGLE__CLIENT_SECRET=
# Absolute base URL of THIS backend as the IdP sees it; the callback
# registered with each IdP is <base>/api/v1/auth/oauth/<provider-key>/callback.
# Empty -> derived from the incoming request.
#CLIVER_OIDC__REDIRECT_BASE=
# MIGRATION: the legacy flat CLIVER_OIDC_* names (ENABLED/ISSUER/CLIENT_ID/
# CLIENT_SECRET/REDIRECT_BASE/AUTO_PROVISION/DEFAULT_ROLE) no longer exist
# and are now SILENTLY IGNORED (extra=ignore). Remove them from deployed
# .env files — otherwise SSO buttons vanish with no error message.

# --- OAuth 2.1 provider (AI-agent / API clients) ---
# Switch the whole provider surface off when no agent clients will connect.
CLIVER_OAUTH21_ENABLED=true
# External base URL of this service as agents reach it — the `iss` value.
# Set it explicitly behind proxies that rewrite Host: `iss` must match the
# URL the client used byte-for-byte. Empty -> derived per request.
CLIVER_OAUTH21_ISSUER_URL=
CLIVER_OAUTH21_ACCESS_TTL_SECONDS=3600
CLIVER_OAUTH21_REFRESH_TTL_SECONDS=2592000
CLIVER_OAUTH21_CODE_TTL_SECONDS=300
CLIVER_OAUTH21_LOGIN_TTL_SECONDS=600
# Refresh-replay grace window: replays inside it are audited as network
# retries instead of revoking the whole token family.
CLIVER_OAUTH21_REPLAY_GRACE_SECONDS=30
