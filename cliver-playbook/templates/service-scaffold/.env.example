# Optional overrides — every variable already has a working default (see
# backend/app/core/config.py). Copy to .env to change values; never commit
# the real .env file.

# PostgreSQL connection string in canonical postgresql:// form. The default
# matches the bundled docker-compose db (make db-up), so local development
# needs no .env at all. The app derives the async (asyncpg) and sync
# (psycopg, Alembic-only) URLs from this single value.
CLIVER_DATABASE_URL=postgresql://cliver:cliver@127.0.0.1:5432/cliver_app

# Application display name (FastAPI title, frontend branding).
CLIVER_APP_NAME=cliver-app

# Log level for the backend (DEBUG / INFO / WARNING / ERROR).
CLIVER_LOG_LEVEL=INFO
