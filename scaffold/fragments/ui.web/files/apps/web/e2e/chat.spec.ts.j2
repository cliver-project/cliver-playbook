{% if enabled('ui.agent.chat') %}
import { expect, test } from "@playwright/test";

const user = {
  id: 1,
  username: "e2e",
  email: null,
  phone: null,
  display_name: "E2E User",
  is_active: true,
  must_change_password: false,
  created_at: "2026-01-01T00:00:00Z",
  role_codes: ["user"],
  permissions: ["*"],
};

const events = [
  { type: "run.started" },
  {
    type: "coordinator.plan",
    intent: { name: "products", confidence: 1, payload: {} },
  },
  { type: "agent.selected", agent: "products", reason: "planner:deterministic" },
  {
    type: "tool.call",
    tool_call_id: "call-1",
    name: "products_list",
    arguments: { limit: 5 },
  },
  {
    type: "tool.result",
    tool_call_id: "call-1",
    result: "[]",
    is_error: false,
  },
  { type: "agent.result", agent: "products", message: "Found 3 product(s).", data: {} },
  { type: "message.delta", delta: "Found 3 product(s)." },
  { type: "run.completed" },
];

const sse = events
  .map(
    (event, sequence) =>
      `event: ${event.type}\ndata: ${JSON.stringify({
        ...event,
        run_id: "run-1",
        sequence,
      })}\n\n`,
  )
  .join("");

test("chat streams events, shows a tool card and routes to products", async ({
  page,
}) => {
  await page.addInitScript(() => {
    window.localStorage.setItem("cliver-token", "e2e-token");
  });

  await page.route("**/api/v1/auth/me", (route) =>
    route.fulfill({
      status: 200,
      contentType: "application/json",
      body: JSON.stringify({ user }),
    }),
  );
  await page.route("**/api/v1/products**", (route) =>
    route.fulfill({
      status: 200,
      contentType: "application/json",
      body: "[]",
    }),
  );
  await page.route("**/api/v1/agent/runs", (route) =>
    route.fulfill({
      status: 202,
      contentType: "application/json",
      body: JSON.stringify({ run_id: "run-1", status: "queued" }),
    }),
  );
  await page.route("**/api/v1/agent/runs/run-1/events", (route) =>
    route.fulfill({
      status: 200,
      headers: { "Cache-Control": "no-cache" },
      contentType: "text/event-stream",
      body: sse,
    }),
  );
  await page.route("**/api/v1/agent/runs/run-1/feedback", (route) =>
    route.fulfill({
      status: 201,
      contentType: "application/json",
      body: JSON.stringify({
        feedback_id: 1,
        experience_id: 1,
        evaluation: {
          status: "evaluated",
          agent: "products",
          metric: "products.list.success",
          score: 1,
          passed: true,
          details: {},
        },
        proposal: null,
      }),
    }),
  );

  await page.goto("/");
  await expect(page.getByRole("heading", { name: "Ask anything" })).toBeVisible();
  await expect(page.getByRole("log")).toBeVisible();

  await page.getByLabel("Ask a question…").fill("list products");
  await page.getByRole("button", { name: "Send" }).click();

  await expect(page.getByText("Found 3 product(s).")).toBeVisible();
  await expect(page.getByText("products_list")).toBeVisible();

  await page.getByRole("button", { name: "Helpful", exact: true }).click();
  await expect(page.getByText("Thanks for the feedback.")).toBeVisible();

  const openProducts = page.getByRole("link", { name: "Open products" });
  await expect(openProducts).toBeVisible();
  await openProducts.click();
  await expect(page).toHaveURL(/\/products$/);
});
{% endif %}
