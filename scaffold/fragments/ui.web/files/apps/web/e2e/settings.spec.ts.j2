{% if enabled('api.agent') %}
import { expect, test } from "@playwright/test";

const user = {
  id: 1,
  username: "reviewer",
  email: null,
  phone: null,
  display_name: "Reviewer",
  is_active: true,
  must_change_password: false,
  created_at: "2026-01-01T00:00:00Z",
  role_codes: ["admin"],
  permissions: ["*"],
};

test("runtime settings show safe feature flags", async ({ page }) => {
  await page.addInitScript(() => {
    window.localStorage.setItem("cliver-token", "e2e-token");
  });
  await page.route("**/api/v1/auth/me", (route) =>
    route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify({ user }) }),
  );
  await page.route("**/api/v1/agent/runtime", (route) =>
    route.fulfill({
      status: 200,
      contentType: "application/json",
      body: JSON.stringify({
        model_configured: true,
        judge_enabled: false,
        mcp_enabled: true,
        compaction_enabled: false,
        tool_permission_mode: "scoped",
        system_one_provider: "local",
        model_provider: "deepseek",
        model_name: "deepseek-chat",
        mcp_servers: ["echo", "catalog"],
      }),
    }),
  );
  await page.route("**/api/v1/agent/agents", (route) =>
    route.fulfill({
      status: 200,
      contentType: "application/json",
      body: JSON.stringify({
        agents: [
          {
            name: "products",
            description: "List the project's products.",
            capabilities: ["products.list"],
            autonomy_mode: "proposal",
            has_pipeline: true,
          },
        ],
      }),
    }),
  );

  await page.goto("/runtime");
  await expect(page.getByRole("heading", { name: "Runtime settings" })).toBeVisible();
  await expect(page.getByText("scoped")).toBeVisible();
  await expect(page.getByText("local")).toBeVisible();
  await expect(page.getByText("deepseek-chat")).toBeVisible();
  await expect(page.getByText("echo", { exact: true })).toBeVisible();
  await expect(page.getByText("catalog")).toBeVisible();
  await expect(page.getByRole("heading", { name: "Registered agents" })).toBeVisible();
  await expect(page.getByRole("heading", { name: "products" })).toBeVisible();
  await expect(page.getByText("products.list")).toBeVisible();
  await expect(page.getByText("Proposals")).toBeVisible();
  await expect(page.getByText("Self-enhancement pipeline")).toBeVisible();
});
{% endif %}
