{% if enabled('api.agent') %}
import { expect, test } from "@playwright/test";

const user = {
  id: 1,
  username: "reviewer",
  email: null,
  phone: null,
  display_name: "Reviewer",
  is_active: true,
  must_change_password: false,
  created_at: "2026-01-01T00:00:00Z",
  role_codes: ["admin"],
  permissions: ["*"],
};

test("runtime settings show safe feature flags", async ({ page }) => {
  await page.addInitScript(() => {
    window.localStorage.setItem("cliver-token", "e2e-token");
  });
  await page.route("**/api/v1/auth/me", (route) =>
    route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify({ user }) }),
  );
  await page.route("**/api/v1/agent/runtime", (route) =>
    route.fulfill({
      status: 200,
      contentType: "application/json",
      body: JSON.stringify({
        model_configured: true,
        judge_enabled: false,
        mcp_enabled: true,
        compaction_enabled: false,
        tool_permission_mode: "scoped",
        system_one_provider: "local",
      }),
    }),
  );

  await page.goto("/runtime");
  await expect(page.getByRole("heading", { name: "Runtime settings" })).toBeVisible();
  await expect(page.getByText("scoped")).toBeVisible();
  await expect(page.getByText("local")).toBeVisible();
});
{% endif %}
