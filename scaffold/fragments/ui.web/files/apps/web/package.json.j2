{
  "name": "@{{ project_slug }}/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "seam-check": "node scripts/check-ui-seam.mjs",
{% if enabled('ui.agent.chat') %}
    "test:e2e": "playwright test",
{% endif %}
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.7.0",
    "cliver-playbook-app-basic": "github:cliver-project/cliver-playbook#{{ playbook.revision }}&path:/packages/frontend/cliver-playbook-app-basic",
{% if enabled('api.auth') %}
    "cliver-playbook-app-user": "github:cliver-project/cliver-playbook#{{ playbook.revision }}&path:/packages/frontend/cliver-playbook-app-user",
{% endif %}
{% if enabled('api.rag') %}
    "cliver-playbook-app-rag": "github:cliver-project/cliver-playbook#{{ playbook.revision }}&path:/packages/frontend/cliver-playbook-app-rag",
{% endif %}
{% if enabled('api.mcp') %}
    "cliver-playbook-app-mcp": "github:cliver-project/cliver-playbook#{{ playbook.revision }}&path:/packages/frontend/cliver-playbook-app-mcp",
{% endif %}
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
{% if enabled('ui.agent.chat') %}
    "@playwright/test": "^1.56.0",
{% endif %}
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
