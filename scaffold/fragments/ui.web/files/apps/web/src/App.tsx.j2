import { QueryClientProvider } from "@tanstack/react-query";
import {
  BrowserRouter,
  Navigate,
  useRoutes,
  type RouteObject,
} from "react-router-dom";

import {
{% if not enabled('api.auth') %}
  AppLayout,
{% endif %}
  ThemeProvider,
  Toaster,
  basicRoutes,
  queryClient,
} from "cliver-playbook-app-basic";
{% if enabled('api.rag') %}
import { ragNavItems, ragRoutes, ragStandaloneRoutes } from "cliver-playbook-app-rag";
{% endif %}
{% if enabled('api.rag_governance') %}
import {
  govNavItems,
  govRoutes,
  govStandaloneRoutes,
} from "cliver-playbook-app-rag-governance";
{% endif %}
{% if enabled('api.mcp') %}
import { mcpNavItems, mcpRoutes } from "cliver-playbook-app-mcp";
{% endif %}
{% if enabled('api.auth') %}
import {
  AuthAppLayout,
  AuthProvider,
  userRoutes,
  userStandaloneRoutes,
} from "cliver-playbook-app-user";
{% endif %}

import { projectNavItems, projectRoutes } from "./routes";

const routes: RouteObject[] = [
{% if enabled('api.auth') %}
  {
    element: (
      <AuthAppLayout
        extraNavItems={[
{% if enabled('api.rag') %}
          ...ragNavItems,
{% endif %}
{% if enabled('api.rag_governance') %}
          ...govNavItems,
{% endif %}
{% if enabled('api.mcp') %}
          ...mcpNavItems,
{% endif %}
          ...projectNavItems,
        ]}
      />
    ),
    children: [
      ...projectRoutes,
      ...basicRoutes,
      ...userRoutes,
{% if enabled('api.rag') %}
      ...ragRoutes,
{% endif %}
{% if enabled('api.rag_governance') %}
      ...govRoutes,
{% endif %}
{% if enabled('api.mcp') %}
      ...mcpRoutes,
{% endif %}
    ],
  },
  ...userStandaloneRoutes,
{% if enabled('api.rag') %}
  ...ragStandaloneRoutes,
{% endif %}
{% if enabled('api.rag_governance') %}
  ...govStandaloneRoutes,
{% endif %}
{% else %}
  {
    element: (
      <AppLayout
        navItems={[
{% if enabled('api.rag') %}
          ...ragNavItems,
{% endif %}
{% if enabled('api.rag_governance') %}
          ...govNavItems,
{% endif %}
{% if enabled('api.mcp') %}
          ...mcpNavItems,
{% endif %}
          ...projectNavItems,
        ]}
      />
    ),
    children: [
      ...projectRoutes,
      ...basicRoutes,
{% if enabled('api.rag') %}
      ...ragRoutes,
{% endif %}
{% if enabled('api.rag_governance') %}
      ...govRoutes,
{% endif %}
{% if enabled('api.mcp') %}
      ...mcpRoutes,
{% endif %}
    ],
  },
{% endif %}
  { path: "*", element: <Navigate to="/" replace /> },
];

function AppRoutes() {
  return useRoutes(routes);
}

export default function App() {
  return (
    <QueryClientProvider client={queryClient}>
      <ThemeProvider>
        <BrowserRouter>
{% if enabled('api.auth') %}
          <AuthProvider>
            <AppRoutes />
            <Toaster />
          </AuthProvider>
{% else %}
          <AppRoutes />
          <Toaster />
{% endif %}
        </BrowserRouter>
      </ThemeProvider>
    </QueryClientProvider>
  );
}
