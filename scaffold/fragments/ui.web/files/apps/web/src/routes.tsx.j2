import { lazy, Suspense } from "react";
import type { RouteObject } from "react-router-dom";

{% if enabled('api.auth') %}
import type { AuthedNavItem } from "cliver-playbook-app-user";
{% else %}
import type { NavItem } from "cliver-playbook-app-basic";
{% endif %}
{% if enabled('ui.web.products') %}
import { productNavItems, productRoutes } from "./features/products/routes";
{% endif %}
{% if enabled('api.agent') %}
import { governanceNavItems, governanceRoutes } from "./features/governance/routes";
import { settingsNavItems, settingsRoutes } from "./features/settings/routes";
{% endif %}

import { LoadingState } from "./ui";

const HomePage = lazy(() => import("./pages/HomePage"));

export const projectRoutes: RouteObject[] = [
  {
    index: true,
    element: (
      <Suspense fallback={<LoadingState />}>
        <HomePage />
      </Suspense>
    ),
  },
{% if enabled('ui.web.products') %}
  ...productRoutes,
{% endif %}
{% if enabled('api.agent') %}
  ...governanceRoutes,
  ...settingsRoutes,
{% endif %}
];

{% if enabled('api.auth') %}
export const projectNavItems: AuthedNavItem[] = [
{% if enabled('ui.web.products') %}
  ...productNavItems,
{% endif %}
{% if enabled('api.agent') %}
  ...governanceNavItems,
  ...settingsNavItems,
{% endif %}
];
{% else %}
export const projectNavItems: NavItem[] = [
{% if enabled('ui.web.products') %}
  ...productNavItems,
{% endif %}
{% if enabled('api.agent') %}
  ...governanceNavItems,
  ...settingsNavItems,
{% endif %}
];
{% endif %}
