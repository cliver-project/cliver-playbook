{% if enabled('api.agent') %}
import { useQuery } from "@tanstack/react-query";
import { useTranslation } from "react-i18next";

import { Card, CardContent, CardHeader, CardTitle, ErrorState, LoadingState } from "../../ui";
import { getAgentCatalog, getRuntimeStatus } from "./api";

function readError(error: unknown): string {
  return error instanceof Error ? error.message : String(error);
}

export default function SettingsPage() {
  const { t } = useTranslation();
  const status = useQuery({ queryKey: ["agent-runtime"], queryFn: getRuntimeStatus });
  const agents = useQuery({ queryKey: ["agent-catalog"], queryFn: getAgentCatalog });

  if (status.isPending || agents.isPending) return <LoadingState />;
  if (status.error) return <ErrorState message={readError(status.error)} />;

  const data = status.data;
  if (!data) return null;
  const autonomyLabel = {
    off: t("settings.autonomyOff"),
    proposal: t("settings.autonomyProposal"),
    auto: t("settings.autonomyAuto"),
  } as const;
  const flags = [
    ["modelConfigured", data.model_configured],
    ["judgeEnabled", data.judge_enabled],
    ["mcpEnabled", data.mcp_enabled],
    ["compactionEnabled", data.compaction_enabled],
  ] as const;

  return (
    <section className="mx-auto flex max-w-3xl flex-col gap-4 p-4 md:p-8">
      <header>
        <h1 className="text-2xl font-semibold md:text-3xl">{t("settings.title")}</h1>
        <p className="mt-1 text-sm text-muted-foreground">{t("settings.subtitle")}</p>
      </header>

      <div className="grid gap-3 sm:grid-cols-2">
        {flags.map(([key, enabled]) => (
          <Card key={key}>
            <CardHeader><CardTitle className="text-sm">{t(`settings.${key}`)}</CardTitle></CardHeader>
            <CardContent className="text-lg font-semibold">
              {enabled ? t("settings.enabled") : t("settings.disabled")}
            </CardContent>
          </Card>
        ))}
        <Card>
          <CardHeader><CardTitle className="text-sm">{t("settings.permissionMode")}</CardTitle></CardHeader>
          <CardContent className="text-lg font-semibold">{data.tool_permission_mode}</CardContent>
        </Card>
        <Card>
          <CardHeader><CardTitle className="text-sm">{t("settings.systemOne")}</CardTitle></CardHeader>
          <CardContent className="text-lg font-semibold">
            {data.system_one_provider || t("settings.disabled")}
          </CardContent>
        </Card>
      </div>

      <section aria-labelledby="registered-agents" className="space-y-2">
        <h2 id="registered-agents" className="text-lg font-semibold">
          {t("settings.agents")}
        </h2>
        {agents.error ? (
          <p role="alert" className="text-sm text-destructive">
            {readError(agents.error)}
          </p>
        ) : null}
        {agents.data && agents.data.length === 0 ? (
          <p className="text-sm text-muted-foreground">{t("settings.agentsEmpty")}</p>
        ) : null}
        <ul className="grid gap-3 md:grid-cols-2">
          {agents.data?.map((agent) => (
            <li key={agent.name} className="rounded-lg border bg-card p-4">
              <div className="flex flex-wrap items-center justify-between gap-2">
                <h3 className="font-medium">{agent.name}</h3>
                <span className="rounded-full border px-2 py-0.5 text-xs text-muted-foreground">
                  {autonomyLabel[agent.autonomy_mode]}
                </span>
              </div>
              <p className="mt-1 text-sm text-muted-foreground">{agent.description}</p>
              <div className="mt-2 flex flex-wrap gap-1">
                {agent.capabilities.map((capability) => (
                  <span
                    key={capability}
                    className="rounded-full bg-muted px-2 py-0.5 text-xs"
                  >
                    {capability}
                  </span>
                ))}
              </div>
              <p className="mt-2 text-xs text-muted-foreground">
                {agent.has_pipeline ? t("settings.pipelineOn") : t("settings.pipelineOff")}
              </p>
            </li>
          ))}
        </ul>
      </section>
    </section>
  );
}
{% endif %}
