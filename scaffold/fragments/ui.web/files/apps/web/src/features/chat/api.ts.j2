{% if enabled('api.auth') %}
import { TOKEN_STORAGE_KEY } from "cliver-playbook-app-user";
{% endif %}

import type { components } from "../../contracts/schema";

export type AgentRunRequest = components["schemas"]["AgentRunRequest"];
export type AgentRunCreated = components["schemas"]["AgentRunCreated"];
export type AgentFeedbackRequest = components["schemas"]["AgentFeedbackRequest"];

export type AgentEvent = {
  type: string;
  run_id?: string;
  sequence?: number;
  delta?: string;
  agent?: string;
  step?: number;
  parallel_group?: number | null;
  target?: string;
  reason?: string;
  depth?: number;
  tool_call_id?: string;
  name?: string;
  arguments?: Record<string, unknown>;
  result?: unknown;
  is_error?: boolean;
  message?: string;
  code?: string;
};

export async function startRun(message: string): Promise<string> {
  const response = await fetch("/api/v1/agent/runs", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      ...authHeaders(),
    },
    body: JSON.stringify({ message } satisfies AgentRunRequest),
  });
  if (!response.ok) {
    throw new Error((await response.text()) || `HTTP ${response.status}`);
  }
  const data = (await response.json()) as AgentRunCreated;
  if (!data.run_id) {
    throw new Error("The API did not return a run id.");
  }
  return data.run_id;
}

export async function streamRun(
  runId: string,
  onEvent: (event: AgentEvent) => void,
  signal?: AbortSignal,
  lastEventId?: number,
): Promise<void> {
  const response = await fetch(`/api/v1/agent/runs/${runId}/events`, {
    headers: {
      Accept: "text/event-stream",
      ...(lastEventId !== undefined
        ? { "Last-Event-ID": String(lastEventId) }
        : {}),
      ...authHeaders(),
    },
    signal,
  });
  if (!response.ok) {
    throw new Error((await response.text()) || `HTTP ${response.status}`);
  }
  if (!response.body) {
    throw new Error("This browser does not support streamed responses.");
  }

  const reader = response.body.getReader();
  const decoder = new TextDecoder();
  let buffer = "";
  const emit = (block: string) => {
    const data = block
      .split("\n")
      .filter((line) => line.startsWith("data:"))
      .map((line) => line.slice(5).trimStart())
      .join("\n");
    if (!data) return;
    try {
      onEvent(JSON.parse(data) as AgentEvent);
    } catch {
      // A malformed or keepalive block must not kill the stream.
    }
  };

  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    buffer += decoder.decode(value, { stream: true }).replace(/\r\n/g, "\n");
    let boundary = buffer.indexOf("\n\n");
    while (boundary >= 0) {
      emit(buffer.slice(0, boundary));
      buffer = buffer.slice(boundary + 2);
      boundary = buffer.indexOf("\n\n");
    }
  }
  if (buffer.trim()) emit(buffer);
}

export async function cancelRun(runId: string): Promise<void> {
  await fetch(`/api/v1/agent/runs/${runId}/cancel`, {
    method: "POST",
    headers: authHeaders(),
  });
}

export async function submitFeedback(
  runId: string,
  agent: string,
  rating: number,
  comment = "",
): Promise<void> {
  const response = await fetch(`/api/v1/agent/runs/${runId}/feedback`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      ...authHeaders(),
    },
    body: JSON.stringify({ agent, rating, comment } satisfies AgentFeedbackRequest),
  });
  if (!response.ok) {
    throw new Error((await response.text()) || `HTTP ${response.status}`);
  }
}

function authHeaders(): Record<string, string> {
{% if enabled('api.auth') %}
  const token = localStorage.getItem(TOKEN_STORAGE_KEY);
  return token ? { Authorization: `Bearer ${token}` } : {};
{% else %}
  return {};
{% endif %}
}
{% endif %}
