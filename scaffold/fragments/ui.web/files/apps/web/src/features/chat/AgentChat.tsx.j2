{% if enabled('ui.agent.chat') %}
{%- set has_agent_routes = enabled('ui.web.products') or enabled('api.auth') %}
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { useEffect, useRef, useState } from "react";
import { useTranslation } from "react-i18next";
{% if enabled('ui.web.products') or enabled('api.auth') %}
import { Link } from "react-router-dom";
{% endif %}

{% if enabled('ui.web.products') or enabled('api.auth') %}
import {
  Button,
  ChatMessage,
  ChatShell,
  Composer,
  FeedbackButtons,
  ToolCallCard,
} from "../../ui";
{% else %}
import {
  ChatMessage,
  ChatShell,
  Composer,
  FeedbackButtons,
  ToolCallCard,
} from "../../ui";
{% endif %}
import {
  cancelRun,
  getSession,
  listSessions,
  startRun,
  streamRun,
  submitFeedback,
  type AgentEvent,
} from "./api";

import { RunInspector } from "../../ui";
import type { RunAgentResult, RunHandoff, RunPlanStep } from "../../ui";
import { SessionSidebar } from "./SessionSidebar";
import {
  currentSessionId,
  newSessionId,
  rememberSessionId,
  sessionHistory,
} from "./history";

type ChatEntry = {
  id: string;
  role: "user" | "assistant";
  text: string;
};

type ToolRun = {
  id: string;
  name: string;
  arguments: Record<string, unknown>;
  result?: unknown;
  error?: boolean;
};

type FeedbackTarget = {
  runId: string;
  agent: string;
};

export default function AgentChat() {
  const { t } = useTranslation();
  const [messages, setMessages] = useState<ChatEntry[]>([]);
  const [tools, setTools] = useState<ToolRun[]>([]);
  const [plan, setPlan] = useState<RunPlanStep[]>([]);
  const [runAgents, setRunAgents] = useState<RunAgentResult[]>([]);
  const [handoffs, setHandoffs] = useState<RunHandoff[]>([]);
  const [sessionId, setSessionId] = useState(currentSessionId);
  const [loadingSession, setLoadingSession] = useState(false);
  const [sessionError, setSessionError] = useState<string | null>(null);
  const [input, setInput] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [feedbackTarget, setFeedbackTarget] = useState<FeedbackTarget | null>(
    null,
  );
  const [feedbackRating, setFeedbackRating] = useState<number | null>(null);
  const [feedbackError, setFeedbackError] = useState<string | null>(null);
{% if has_agent_routes %}
  const [agentName, setAgentName] = useState<string | null>(null);
{% endif %}
  const queryClient = useQueryClient();
  const sessionsQuery = useQuery({
    queryKey: ["agent-sessions"],
    queryFn: () => listSessions(50),
  });
  const abortRef = useRef<AbortController | null>(null);
  const runIdRef = useRef<string | null>(null);
  const agentRef = useRef("general");

  useEffect(
    () => () => {
      abortRef.current?.abort();
      const runId = runIdRef.current;
      if (runId) void cancelRun(runId);
    },
    [],
  );

  const handleEvent = (event: AgentEvent, assistantId: string) => {
    switch (event.type) {
      case "coordinator.plan":
        setPlan(
          (event.steps ?? []).map((step) => ({
            name: String(step.name ?? "general"),
            confidence: step.confidence,
            parallelGroup: step.parallel_group ?? null,
          })),
        );
        break;
      case "agent.selected":
        agentRef.current = event.agent ?? "general";
{% if has_agent_routes %}
        setAgentName(event.agent ?? null);
{% endif %}
        break;
      case "agent.result":
        // The final result, not the last selection, owns the feedback target
        // (a parallel group can select several agents).
        agentRef.current = event.agent ?? agentRef.current;
        setRunAgents((current) => [
          ...current,
          { agent: event.agent ?? "general", message: event.message },
        ]);
{% if has_agent_routes %}
        setAgentName(event.agent ?? null);
{% endif %}
        break;
      case "agent.handoff":
        setHandoffs((current) => [
          ...current,
          {
            from: event.agent ?? "unknown",
            to: event.target ?? "unknown",
            reason: event.reason,
            depth: event.depth,
          },
        ]);
        break;
      case "run.completed": {
        const runId = runIdRef.current;
        if (runId) {
          setFeedbackTarget({ runId, agent: agentRef.current });
        }
        break;
      }
      case "message.delta":
        setMessages((current) =>
          current.map((message) =>
            message.id === assistantId
              ? { ...message, text: message.text + String(event.delta ?? "") }
              : message,
          ),
        );
        break;
      case "tool.call": {
        const id = String(event.tool_call_id ?? "");
        setTools((current) => [
          ...current,
          {
            id,
            name: String(event.name ?? "tool"),
            arguments: event.arguments ?? {},
          },
        ]);
        break;
      }
      case "tool.result": {
        const id = String(event.tool_call_id ?? "");
        setTools((current) =>
          current.map((tool) =>
            tool.id === id
              ? {
                  ...tool,
                  result: event.result,
                  error: Boolean(event.is_error),
                }
              : tool,
          ),
        );
        break;
      }
      case "run.failed":
        setError(String(event.message ?? t("chat.failed")));
        break;
      default:
        break;
    }
  };

  const resetRunState = () => {
    setTools([]);
    setPlan([]);
    setRunAgents([]);
    setHandoffs([]);
    setFeedbackTarget(null);
    setFeedbackRating(null);
    setFeedbackError(null);
    setError(null);
    setSessionError(null);
  };

  const openSession = async (nextSessionId: string) => {
    if (busy || loadingSession || nextSessionId === sessionId) return;
    setLoadingSession(true);
    setSessionError(null);
    try {
      const detail = await getSession(nextSessionId);
      const history = sessionHistory(detail);
      rememberSessionId(nextSessionId);
      setSessionId(nextSessionId);
      setMessages(
        history.messages.map((message) => ({ id: newId(), ...message })),
      );
      setPlan(history.plan);
      setRunAgents(history.results);
      setHandoffs(history.handoffs);
      setTools([]);
      setFeedbackTarget(null);
      setFeedbackRating(null);
      setFeedbackError(null);
      setError(null);
    } catch (reason) {
      setSessionError(reason instanceof Error ? reason.message : String(reason));
    } finally {
      setLoadingSession(false);
    }
  };

  const startNewSession = () => {
    if (busy || loadingSession) return;
    const nextSessionId = newSessionId();
    setSessionId(nextSessionId);
    setMessages([]);
    setInput("");
    resetRunState();
  };

  const send = async () => {
    const text = input.trim();
    if (!text || busy) return;
    const assistantId = newId();
    setInput("");
    setBusy(true);
    setError(null);
    setFeedbackTarget(null);
    setFeedbackRating(null);
    setFeedbackError(null);
    agentRef.current = "general";
{% if has_agent_routes %}
    setAgentName(null);
{% endif %}
    setTools([]);
    setPlan([]);
    setRunAgents([]);
    setHandoffs([]);
    setMessages((current) => [
      ...current,
      { id: newId(), role: "user", text },
      { id: assistantId, role: "assistant", text: "" },
    ]);
    try {
      const runId = await startRun(text, sessionId);
      runIdRef.current = runId;
      const controller = new AbortController();
      abortRef.current = controller;
      await streamRun(
        runId,
        (event) => handleEvent(event, assistantId),
        controller.signal,
      );
    } catch (reason) {
      if (!(reason instanceof DOMException && reason.name === "AbortError")) {
        setError(reason instanceof Error ? reason.message : String(reason));
      }
    } finally {
      setBusy(false);
      abortRef.current = null;
      runIdRef.current = null;
      void queryClient.invalidateQueries({ queryKey: ["agent-sessions"] });
    }
  };

  const stop = () => {
    abortRef.current?.abort();
    const runId = runIdRef.current;
    if (runId) void cancelRun(runId);
    setBusy(false);
  };

  const rate = async (rating: number) => {
    if (!feedbackTarget) return;
    setFeedbackError(null);
    try {
      await submitFeedback(feedbackTarget.runId, feedbackTarget.agent, rating);
      setFeedbackRating(rating);
    } catch (reason) {
      setFeedbackError(
        reason instanceof Error ? reason.message : t("chat.feedbackFailed"),
      );
    }
  };

  return (
    <ChatShell
      title={t("chat.title")}
      subtitle={t("chat.subtitle")}
      aside={
        <SessionSidebar
          sessions={sessionsQuery.data ?? []}
          currentSessionId={sessionId}
          loading={sessionsQuery.isPending || loadingSession}
          error={
            sessionError ??
            (sessionsQuery.error ? readError(sessionsQuery.error) : null)
          }
          disabled={busy || loadingSession}
          title={t("chat.sessions")}
          newLabel={t("chat.newSession")}
          emptyLabel={t("chat.noSessions")}
          loadingLabel={t("chat.loadingSessions")}
          runCountLabel={(count) => t("chat.runCount", { count })}
          onSelect={(id) => void openSession(id)}
          onNew={startNewSession}
        />
      }
      footer={
        <div className="space-y-2">
{% if enabled('ui.web.products') %}
          {agentName === "products" ? (
            <Button asChild size="sm" variant="outline">
              <Link to="/products">{t("chat.openProducts")}</Link>
            </Button>
          ) : null}
{% endif %}
{% if enabled('api.auth') %}
          {agentName === "profile" ? (
            <Button asChild size="sm" variant="outline">
              <Link to="/profile">{t("chat.openProfile")}</Link>
            </Button>
          ) : null}
{% endif %}
          <Composer
            value={input}
            onChange={setInput}
            onSubmit={() => void send()}
            onStop={stop}
            busy={busy}
            placeholder={t("chat.placeholder")}
            sendLabel={t("chat.send")}
            stopLabel={t("chat.stop")}
          />
        </div>
      }
    >
      {plan.length > 0 || runAgents.length > 0 || handoffs.length > 0 ? (
        <RunInspector
          title={t("chat.runDetails")}
          planLabel={t("chat.runPlan")}
          agentsLabel={t("chat.runAgents")}
          handoffsLabel={t("chat.runHandoffs")}
          parallelLabel={t("chat.runParallel")}
          emptyLabel={t("chat.runEmpty")}
          steps={plan}
          results={runAgents}
          handoffs={handoffs}
        />
      ) : null}
      <div
        role="log"
        aria-live="polite"
        aria-relevant="additions text"
        aria-busy={busy}
        className="space-y-4"
      >
      {messages.length === 0 ? (
        <p className="text-sm text-muted-foreground">{t("chat.empty")}</p>
      ) : null}
      {messages.map((message, index) => {
        const text =
          message.text ||
          (busy && message.role === "assistant" && index === messages.length - 1
            ? t("chat.thinking")
            : "");
        return text ? (
          <ChatMessage key={message.id} role={message.role}>
            {text}
          </ChatMessage>
        ) : null;
      })}
      {tools.length > 0 ? (
        <div className="space-y-2">
          {tools.map((tool) => (
            <ToolCallCard
              key={tool.id}
              name={tool.name}
              arguments={tool.arguments}
              result={tool.result}
              error={tool.error}
              resultLabel={t("chat.toolResult")}
              errorLabel={t("chat.toolError")}
            />
          ))}
        </div>
      ) : null}
      {feedbackTarget && !busy ? (
        <FeedbackButtons
          value={feedbackRating}
          onRate={(rating) => void rate(rating)}
          helpfulLabel={t("chat.helpful")}
          notHelpfulLabel={t("chat.notHelpful")}
          thanksLabel={t("chat.feedbackThanks")}
        />
      ) : null}
      {feedbackError ? (
        <p role="alert" className="text-sm text-destructive">
          {feedbackError}
        </p>
      ) : null}
      {error ? (
        <p role="alert" className="text-sm text-destructive">
          {error}
        </p>
      ) : null}
      </div>
    </ChatShell>
  );
}

function newId(): string {
  return globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random()}`;
}

function readError(error: unknown): string {
  return error instanceof Error ? error.message : String(error);
}
{% endif %}
