{% if enabled('api.agent') %}
import { api } from "cliver-playbook-app-basic";

import type { components } from "../../contracts/schema";

export type AgentDescriptor = components["schemas"]["AgentDescriptor"];
export type AgentLearningSummary = components["schemas"]["AgentLearningSummary"];
export type AgentProposal = components["schemas"]["AgentProposal"];
export type GoldenVersion = components["schemas"]["AgentGoldenSetVersion"];
export type ConfigVersion = components["schemas"]["AgentConfigVersion"];

export async function listAgents(): Promise<AgentDescriptor[]> {
  const response = await api.get<{ agents: AgentDescriptor[] }>("/agent/agents");
  return response.data.agents;
}

export async function getLearningSummary(agent: string): Promise<AgentLearningSummary> {
  const response = await api.get<AgentLearningSummary>(`/agent/agents/${agent}/learning`);
  return response.data;
}

export async function listProposals(agent: string): Promise<AgentProposal[]> {
  const response = await api.get<{ proposals: AgentProposal[] }>("/agent/proposals", {
    params: { agent },
  });
  return response.data.proposals;
}

export async function listGoldenVersions(agent: string): Promise<GoldenVersion[]> {
  const response = await api.get<{ versions: GoldenVersion[] }>(
    "/agent/golden-set/versions",
    { params: { agent } },
  );
  return response.data.versions;
}

export async function listConfigVersions(agent: string): Promise<ConfigVersion[]> {
  const response = await api.get<{ versions: ConfigVersion[] }>(
    `/agent/agents/${agent}/config/versions`,
  );
  return response.data.versions;
}

export async function approveProposal(id: string): Promise<void> {
  await api.post(`/agent/proposals/${id}/approve`);
}

export async function rejectProposal(id: string): Promise<void> {
  await api.post(`/agent/proposals/${id}/reject`, { note: "Rejected from dashboard" });
}

export async function publishGoldenSet(agent: string): Promise<void> {
  await api.post("/agent/golden-set/publish", {
    agent,
    note: "Published from dashboard",
  });
}

export async function activateGoldenVersion(versionId: number): Promise<void> {
  await api.post(`/agent/golden-set/versions/${versionId}/activate`);
}

export async function rollbackConfig(agent: string, version: number): Promise<void> {
  await api.post(`/agent/agents/${agent}/config/rollback/${version}`, {
    note: `Rollback to v${version} from dashboard`,
  });
}

export async function setAgentRollout(agent: string, percent: number): Promise<void> {
  await api.post(`/agent/agents/${agent}/config/rollout`, { percent });
}
{% endif %}
