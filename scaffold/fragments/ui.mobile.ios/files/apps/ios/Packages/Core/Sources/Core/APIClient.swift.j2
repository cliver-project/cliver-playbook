import Contracts
import Foundation

public enum APIError: Error, LocalizedError {
    case invalidURL
    case invalidResponse
    case unauthorized
    case http(status: Int, message: String)
    case decoding(Error)
    case transport(Error)

    public var errorDescription: String? {
        switch self {
        case .invalidURL:
            return "The API base URL is invalid."
        case .invalidResponse:
            return "The server returned an invalid response."
        case .unauthorized:
            return "Your session expired. Sign in again to continue."
        case let .http(status, message):
            return "Request failed (\(status)): \(message)"
        case let .decoding(error):
            return "The server response could not be read: \(error.localizedDescription)"
        case let .transport(error):
            return error.localizedDescription
        }
    }
}

/// HTTP client for the project's API. The base URL comes from the
/// `API_BASE_URL` Info.plist key and falls back to the documented local
/// development default.
public final class APIClient: @unchecked Sendable {
    /// The documented local development default. Change it in Info.plist for
    /// every other environment; no other host is known to the scaffold.
    public static let defaultBaseURL = URL(string: "http://127.0.0.1:8000/api/v1")!

    public let baseURL: URL

    private let session: URLSession
    private let lock = NSLock()
    private var token: String?
    private var unauthorizedHandler: (@Sendable () async -> Void)?

    public init(baseURL: URL? = nil, session: URLSession = .shared) {
        self.baseURL = baseURL ?? APIClient.configuredBaseURL()
        self.session = session
        var components = URLComponents(url: self.baseURL, resolvingAgainstBaseURL: false)
        components?.path = ""
        components?.query = nil
        ContractsAPI.basePath = components?.url?.absoluteString ?? self.baseURL.absoluteString
    }

    public static func configuredBaseURL(
        bundle: Bundle = .main,
        key: String = "API_BASE_URL"
    ) -> URL {
        if let raw = bundle.object(forInfoDictionaryKey: key) as? String,
           let url = URL(string: raw),
           !raw.isEmpty {
            return url
        }
        return defaultBaseURL
    }

    /// Sets the bearer token used for authenticated requests.
    public func setToken(_ token: String?) {
        lock.lock()
        self.token = token
        lock.unlock()
        if let token, !token.isEmpty {
            ContractsAPI.customHeaders["Authorization"] = "Bearer \(token)"
        } else {
            ContractsAPI.customHeaders.removeValue(forKey: "Authorization")
        }
    }

    /// Called exactly once per authenticated 401 response, after the client
    /// has dropped its in-memory token. The session store uses it to clear
    /// persisted credentials and return to sign-in.
    public func setUnauthorizedHandler(_ handler: (@Sendable () async -> Void)?) {
        lock.lock()
        defer { lock.unlock() }
        unauthorizedHandler = handler
    }

    // MARK: - Auth

    public func login(username: String, password: String) async throws -> AuthSession {
        try await perform {
            try await AuthAPI.login(
                loginRequest: Contracts.LoginRequest(username: username, password: password)
            )
        }
    }

    public func register(
        username: String,
        password: String,
        email: String?,
        displayName: String?
    ) async throws -> AuthSession {
        try await perform {
            try await AuthAPI.register(
                registerRequest: Contracts.RegisterRequest(
                    username: username,
                    password: password,
                    email: email,
                    displayName: displayName
                )
            )
        }
    }

    public func me() async throws -> User {
        let response = try await perform { try await AuthAPI.me() }
        return response.user
    }

    public func updateProfile(
        email: String?,
        phone: String?,
        displayName: String?
    ) async throws -> User {
        let response = try await perform {
            try await AuthAPI.updateProfile(
                profileUpdate: Contracts.ProfileUpdate(
                    email: email,
                    phone: phone,
                    displayName: displayName
                )
            )
        }
        return response.user
    }

    // MARK: - Products

    public func products(limit: Int = 50, offset: Int = 0) async throws -> [Product] {
        try await perform {
            try await ProductsAPI.listProducts(
                limit: Int64(limit),
                offset: Int64(offset)
            )
        }
    }

    public func product(id: Int64) async throws -> Product {
        try await perform { try await ProductsAPI.getProduct(productId: id) }
    }

    public func createProduct(
        name: String,
        description: String,
        priceCents: Int
    ) async throws -> Product {
        try await perform {
            try await ProductsAPI.createProduct(
                productCreate: Contracts.ProductCreate(
                    name: name,
                    description: description,
                    priceCents: priceCents
                )
            )
        }
    }

    public func updateProduct(
        id: Int64,
        name: String,
        description: String,
        priceCents: Int
    ) async throws -> Product {
        try await perform {
            try await ProductsAPI.updateProduct(
                productId: id,
                productUpdate: Contracts.ProductUpdate(
                    name: name,
                    description: description,
                    priceCents: priceCents
                )
            )
        }
    }

    public func deleteProduct(id: Int64) async throws {
        try await perform { try await ProductsAPI.deleteProduct(productId: id) }
    }

