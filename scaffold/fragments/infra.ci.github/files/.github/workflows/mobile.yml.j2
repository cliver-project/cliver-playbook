{% if enabled('ui.mobile.ios') or enabled('ui.mobile.android') %}
name: Mobile

on:
  push:
    branches: [main]
    paths:
      - "apps/ios/**"
      - "apps/android/**"
      - ".github/workflows/mobile.yml"
  pull_request:
    paths:
      - "apps/ios/**"
      - "apps/android/**"
      - ".github/workflows/mobile.yml"

permissions:
  contents: read

jobs:
{% if enabled('ui.mobile.ios') %}
  ios:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - name: Generate the Xcode project
        run: |
          brew install xcodegen
          cd apps/ios && xcodegen generate
      - name: Run Core package tests
        run: |
          cd apps/ios/Packages/Core && swift test
      - name: Build for a generic iOS device
        run: |
          cd apps/ios
          xcodebuild -project {{ project_slug }}.xcodeproj -scheme {{ project_slug }} \
            -destination 'generic/platform=iOS' -derivedDataPath build \
            CODE_SIGNING_ALLOWED=NO build
{% endif %}
{% if enabled('ui.mobile.android') %}
  android:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - uses: gradle/actions/setup-gradle@v4
      - name: Build and test the debug APK
        run: cd apps/android && ./gradlew assembleDebug testDebugUnitTest
{% endif %}
{% endif %}
