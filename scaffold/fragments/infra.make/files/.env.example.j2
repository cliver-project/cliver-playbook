# Copy to .env and adjust for this machine. Never commit .env.
CLIVER_DATABASE_URL=postgresql+asyncpg://cliver:cliver@127.0.0.1:5432/{{ project_slug }}
CLIVER_LOG_LEVEL=INFO

# Model service (local sidecar or remote)
MODEL_CAPABILITIES=llm,embedding,rerank,asr,image,tts,video,system_one

# Provider keys belong here, never in app.yaml or source code.
# CLIVER_RAG__CLIVER_LLM__API_KEY=
{% if enabled('api.agent') %}

# API-plane agent runtime. Leave the model empty for deterministic planning
# and the direct business path. A model enables the AgentCore planner and the
# sub-agent tool loop; set a base URL or a named provider.
# CLIVER_AGENT_LLM_MODEL=
# CLIVER_AGENT_LLM_BASE_URL=
# CLIVER_AGENT_LLM_PROVIDER=
# CLIVER_AGENT_LLM_PROTOCOL=openai
# CLIVER_AGENT_LLM_API_KEY=
# CLIVER_AGENT_SKILLS_DIR=skills
# CLIVER_AGENT_PLAN_MAX_STEPS=8

# Optional System One/Laya tool+skill selector. Empty provider disables it.
# CLIVER_AGENT_SYSTEM_ONE_PROVIDER=local   # local | bailian | typesafe | http
# CLIVER_AGENT_SYSTEM_ONE_MODEL=multilingual
# CLIVER_AGENT_SYSTEM_ONE_MIN_TOOLS=20
# CLIVER_AGENT_SYSTEM_ONE_TOP_K_TOOLS=10
# CLIVER_AGENT_SYSTEM_ONE_MIN_SKILLS=20
# CLIVER_AGENT_SYSTEM_ONE_TOP_K_SKILLS=5
# CLIVER_AGENT_SYSTEM_ONE_FIT_THRESHOLD=0.3
# Bailian: workspace id (or an explicit base URL) plus a DashScope key.
# CLIVER_AGENT_SYSTEM_ONE_WORKSPACE_ID=
# CLIVER_AGENT_SYSTEM_ONE_API_KEY=
# CLIVER_AGENT_SYSTEM_ONE_REGION=cn-beijing
{% endif %}
