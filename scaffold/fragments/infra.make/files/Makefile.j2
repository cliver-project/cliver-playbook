# {{ project_title }} — local development and release commands.
# Generated by cliver-playbook scaffolder. The project owns this file.

.DEFAULT_GOAL := help

BACKEND_HOST ?= 127.0.0.1
BACKEND_PORT ?= 8000
MODEL_PORT ?= 8010
WEB_UI_HOST ?= 127.0.0.1
WEB_UI_PORT ?= 5173
WEB_FILTER := @{{ project_slug }}/web
IOS_DESTINATION ?= generic/platform=iOS Simulator
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
DESKTOP_BUNDLES ?= app
else ifeq ($(UNAME_S),Linux)
DESKTOP_BUNDLES ?= deb
endif
# Use the selected Xcode, or the standard install when only Command Line Tools
# are selected (the iOS build needs xcodebuild).
XCODE_DEVELOPER_DIR ?= $(shell xcode-select -p 2>/dev/null)
ifeq ($(strip $(XCODE_DEVELOPER_DIR)),)
XCODE_DEVELOPER_DIR := /Applications/Xcode.app/Contents/Developer
endif
ifeq ($(findstring CommandLineTools,$(XCODE_DEVELOPER_DIR)),CommandLineTools)
XCODE_DEVELOPER_DIR := /Applications/Xcode.app/Contents/Developer
endif

DEV_TARGETS :={% if enabled('api.python') %} dev-api{% endif %}{% if enabled('model.python') %} dev-model{% endif %}{% if enabled('ui.web') %} dev-web{% endif %}
CHECK_TARGETS :={% if enabled('api.python') %} lint-api test-api{% endif %}{% if enabled('model.python') %} test-model{% endif %}{% if enabled('ui.web') %} web-check{% endif %}{% if enabled('ui.mobile.ios') %} test-ios{% endif %}{% if enabled('ui.mobile.android') %} test-android{% endif %}{% if enabled('contracts.openapi') %} contracts-check{% endif %}
BUILD_TARGETS :={% if enabled('api.python') %} build-api{% endif %}{% if enabled('ui.web') %} build-web{% endif %}{% if enabled('ui.mobile.ios') %} build-ios{% endif %}{% if enabled('ui.mobile.android') %} build-android{% endif %}

.PHONY: help
help: ## Display this help.
	@awk 'BEGIN {FS = ":.*##"; printf "\nUsage:\n  make \033[36m<target>\033[0m\n"} /^[a-zA-Z_0-9-]+:.*?##/ { printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2 } /^##@/ { printf "\n\033[1m%s\033[0m\n", substr($$0, 5) } ' $(MAKEFILE_LIST)

##@ Setup

.PHONY: init
init:{% if enabled('api.python') %} backend-init{% endif %}{% if enabled('model.python') %} model-init{% endif %}{% if enabled('ui.web') %} web-init{% endif %} ## Install every dependency
	@echo "{{ project_slug }} initialized"

{% if enabled('api.python') %}
.PHONY: backend-init
backend-init: ## Install the API dependencies
	cd services/api && uv sync
{% endif %}

{% if enabled('model.python') %}
.PHONY: model-init
model-init: ## Install the model-service dependencies
	cd services/model && uv sync
{% endif %}

{% if enabled('ui.web') %}
.PHONY: web-init
web-init: ## Install the web dependencies
	pnpm install
{% endif %}

{% if enabled('api.python') and enabled('infra.docker') %}
.PHONY: db-up
db-up: ## Start PostgreSQL
	docker compose -f infra/docker/docker-compose.yml up -d db
{% endif %}

{% if enabled('api.python') %}
.PHONY: db-init
db-init:{% if enabled('infra.docker') %} db-up{% endif %} ## Apply every migration chain
	cd services/api && uv run python -m app.migrate
{% endif %}

{% if enabled('contracts.openapi') %}
.PHONY: contracts
contracts: ## Compose the OpenAPI fragments
	uv run --with pyyaml python contracts/compose.py

.PHONY: contracts-check
contracts-check: ## Fail when the composed contract is stale
	uv run --with pyyaml python contracts/compose.py --check
{% endif %}

##@ Development

{% if enabled('api.python') %}
.PHONY: dev-api
dev-api: db-init ## Run the API with auto-reload
	cd services/api && uv run uvicorn --factory app.app:create_app --reload --host $(BACKEND_HOST) --port $(BACKEND_PORT)
{% endif %}

{% if enabled('model.python') %}
.PHONY: dev-model
dev-model: ## Run the model service with auto-reload
	cd services/model && uv run uvicorn --factory model_app.main:create_app --reload --host $(BACKEND_HOST) --port $(MODEL_PORT)
{% endif %}

{% if enabled('ui.web') %}
.PHONY: dev-web
dev-web: ## Run the web UI
	pnpm --filter $(WEB_FILTER) dev --host $(WEB_UI_HOST) --port $(WEB_UI_PORT)
{% endif %}

{% if enabled('ui.desktop.tauri') %}
.PHONY: dev-desktop
dev-desktop:{% if enabled('ui.web') %} build-web{% endif %} ## Run the Tauri desktop shell
	cd apps/desktop && pnpm tauri dev
{% endif %}

{% if enabled('ui.mobile.ios') %}
.PHONY: dev-ios
dev-ios: ## Generate and open the Xcode project
	cd apps/ios && xcodegen generate && open *.xcodeproj
{% endif %}

{% if enabled('ui.mobile.android') %}
.PHONY: dev-android
dev-android: ## Build and install the Android app
	cd apps/android && (test -x ./gradlew && ./gradlew installDebug || gradle installDebug)
{% endif %}

{% if enabled('infra.local-sidecars') %}
.PHONY: sidecars
sidecars: ## Build the local API/model sidecars
	@echo "Sidecar packaging is wired with the desktop shell (Phase 3)."

.PHONY: package-sidecars
package-sidecars: sidecars ## Package the local sidecars
{% endif %}

.PHONY: dev
dev:{% if enabled('infra.docker') %} db-up{% endif %} ## Run the local stack (API, model, web)
	@test -n "$(DEV_TARGETS)" || { echo "no runnable target in this profile" >&2; exit 2; }
	$(MAKE) -j3 $(DEV_TARGETS)

##@ Quality

{% if enabled('api.python') %}
.PHONY: lint-api
lint-api: ## Check API formatting and imports
	cd services/api && uv run ruff check
	cd services/api && uv run ruff format --check

.PHONY: test-api
test-api:{% if enabled('infra.docker') %} db-up{% endif %} ## Run the API tests
	cd services/api && uv run pytest
{% endif %}

{% if enabled('model.python') %}
.PHONY: test-model
test-model: ## Run the model-service tests
	cd services/model && uv run pytest
{% endif %}

{% if enabled('api.agent') %}
.PHONY: system-one-smoke
system-one-smoke: ## Live System One selector check (local laya or a remote provider)
	cd services/api && uv run --extra local-system-one python scripts/system_one_smoke.py
{% endif %}

{% if enabled('ui.web') %}
.PHONY: web-check
web-check: ## Type-check, lint, seam-check and build the web UI
	pnpm --filter $(WEB_FILTER) typecheck
	pnpm --filter $(WEB_FILTER) lint
	pnpm --filter $(WEB_FILTER) seam-check
	pnpm --filter $(WEB_FILTER) build
{% endif %}

{% if enabled('ui.web') and enabled('ui.agent.chat') %}
.PHONY: web-e2e
web-e2e: ## Run the chat E2E with a mocked API (needs `playwright install chromium`)
	pnpm --filter $(WEB_FILTER) test:e2e
{% endif %}

{% if enabled('ui.mobile.ios') %}
.PHONY: test-ios
test-ios: ## Run the iOS Core package tests
	cd apps/ios/Packages/Core && DEVELOPER_DIR='$(XCODE_DEVELOPER_DIR)' swift test
{% endif %}

{% if enabled('ui.mobile.android') %}
.PHONY: test-android
test-android: ## Run the Android unit tests
	cd apps/android && (test -x ./gradlew && ./gradlew testDebugUnitTest || gradle testDebugUnitTest)
{% endif %}

.PHONY: check
check: ## Run every quality gate
	@test -n "$(CHECK_TARGETS)" || { echo "no check target in this profile" >&2; exit 2; }
	$(MAKE) $(CHECK_TARGETS)

##@ Build and release

{% if enabled('api.python') %}
.PHONY: build-api
build-api: ## Build the API wheel
	cd services/api && uv build
{% endif %}

{% if enabled('ui.web') %}
.PHONY: build-web
build-web: ## Build the web bundle
	pnpm --filter $(WEB_FILTER) build
{% endif %}

{% if enabled('ui.mobile.ios') %}
.PHONY: build-ios
build-ios: ## Generate the Xcode project and build an unsigned simulator app
	cd apps/ios && xcodegen generate
	cd apps/ios && DEVELOPER_DIR='$(XCODE_DEVELOPER_DIR)' xcodebuild -project {{ project_slug }}.xcodeproj -scheme {{ project_slug }} -destination '$(IOS_DESTINATION)' -derivedDataPath build CODE_SIGNING_ALLOWED=NO build
{% endif %}

{% if enabled('ui.mobile.android') %}
.PHONY: build-android
build-android: ## Build the Android debug APK
	cd apps/android && (test -x ./gradlew && ./gradlew assembleDebug || gradle assembleDebug)
{% endif %}

.PHONY: build
build: ## Build every enabled target
	@test -n "$(BUILD_TARGETS)" || { echo "no build target in this profile" >&2; exit 2; }
	$(MAKE) $(BUILD_TARGETS)

{% if enabled('ui.desktop.tauri') %}
.PHONY: package-desktop
package-desktop: build-web ## Build the desktop bundle for this host
	cd apps/desktop && pnpm tauri build $(if $(DESKTOP_BUNDLES),--bundles $(DESKTOP_BUNDLES),)
{% endif %}

{% if enabled('ui.mobile.ios') or enabled('ui.mobile.android') %}
.PHONY: package-mobile
package-mobile:{% if enabled('ui.mobile.ios') %} build-ios{% endif %}{% if enabled('ui.mobile.android') %} build-android{% endif %} ## Build local mobile artifacts
	@echo "{% if enabled('ui.mobile.ios') %}iOS simulator app built without signing. {% endif %}{% if enabled('ui.mobile.android') %}Android debug APK built. {% endif %}Use Xcode or Android Studio for signed distribution builds."
{% endif %}

.PHONY: package
package: ## Build the platform installers/artifacts
{% if enabled('ui.desktop.tauri') or enabled('ui.mobile.ios') or enabled('ui.mobile.android') %}
	@$(MAKE) {% if enabled('ui.desktop.tauri') %}package-desktop {% endif %}{% if enabled('ui.mobile.ios') or enabled('ui.mobile.android') %}package-mobile{% endif %}
{% else %}
	@echo "No desktop or mobile package target in this profile."
{% endif %}

.PHONY: release
release: ## Print the release procedure
	@echo "Bump the version, tag it, and let CI build the artifacts."

.PHONY: clean
clean: ## Remove local build and cache output
	rm -rf dist .pytest_cache .ruff_cache .venv services/api/.venv services/model/.venv apps/web/dist apps/ios/build apps/android/app/build apps/desktop/src-tauri/target
	find . -type d -name __pycache__ -prune -exec rm -rf {} +
