"""Test harness: one scratch database per test session."""

import atexit
import os
import uuid

import psycopg
import pytest
from httpx import ASGITransport, AsyncClient

ADMIN_DSN = os.environ.get(
    "CLIVER_TEST_DATABASE_URL",
    "postgresql://cliver:cliver@127.0.0.1:5432/postgres",
)
TEST_DB = f"scaffold_test_{uuid.uuid4().hex[:10]}"
TEST_DSN = ADMIN_DSN.rsplit("/", 1)[0] + f"/{TEST_DB}"


def _create_temp_database() -> None:
    with psycopg.connect(ADMIN_DSN, autocommit=True) as conn:
        conn.execute(f'DROP DATABASE IF EXISTS "{TEST_DB}" WITH (FORCE)')
        conn.execute(f'CREATE DATABASE "{TEST_DB}"')


def _drop_temp_database() -> None:
    with psycopg.connect(ADMIN_DSN, autocommit=True) as conn:
        conn.execute(f'DROP DATABASE IF EXISTS "{TEST_DB}" WITH (FORCE)')


try:
    _create_temp_database()
except Exception as exc:  # noqa: BLE001
    pytest.skip(f"PostgreSQL unavailable: {exc}", allow_module_level=True)

atexit.register(_drop_temp_database)
os.environ["CLIVER_DATABASE_URL"] = TEST_DSN.replace("postgresql://", "postgresql+asyncpg://", 1)
