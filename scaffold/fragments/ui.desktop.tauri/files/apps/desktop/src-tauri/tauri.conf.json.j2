{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{ project_title }}",
  "version": "0.1.0",
  "identifier": "com.example.{{ project_slug }}",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "{{ project_title }}",
