/**
 * Chat-first root. It renders typed API run events and never classifies intent
 * or calls a model provider itself.
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun ChatScreen(
    api: ApiClient,
    onOpenProducts: (() -> Unit)?,
    modifier: Modifier = Modifier,
) {
    val components = LocalAppComponents.current
    val scope = rememberCoroutineScope()
    var messages by remember { mutableStateOf<List<ChatEntry>>(emptyList()) }
    var tools by remember { mutableStateOf<List<ToolEntry>>(emptyList()) }
    var input by rememberSaveable { mutableStateOf("") }
    var busy by remember { mutableStateOf(false) }
    var error by remember { mutableStateOf<String?>(null) }
    var selectedAgent by remember { mutableStateOf<String?>(null) }
    var runID by remember { mutableStateOf<String?>(null) }
    var runJob by remember { mutableStateOf<Job?>(null) }
    var feedbackTarget by remember { mutableStateOf<FeedbackTarget?>(null) }
    var feedbackRating by remember { mutableStateOf<Int?>(null) }
    var feedbackError by remember { mutableStateOf<String?>(null) }

    fun apply(event: AgentEvent, assistantID: String) {
        when (event.type) {
            "agent.selected" -> selectedAgent = event.agent
            "message.delta" -> {
                val delta = event.delta.orEmpty()
                messages = messages.map { message ->
                    if (message.id == assistantID) {
                        message.copy(text = message.text + delta)
                    } else {
                        message
                    }
                }
            }
            "tool.call" -> {
                tools = tools + ToolEntry(
                    id = event.toolCallId ?: UUID.randomUUID().toString(),
                    name = event.name ?: "tool",
                    detail = event.arguments.asDisplayText(),
                )
            }
            "tool.result" -> {
                val toolCallID = event.toolCallId
                if (toolCallID != null) {
                    tools = tools.map { tool ->
                        if (tool.id == toolCallID) {
                            tool.copy(
                                detail = event.result.asDisplayText(),
                                isError = event.isError,
                            )
                        } else {
                            tool
                        }
                    }
                }
            }
            "run.failed" -> error = event.message ?: "The run failed."
        }
    }

    fun send() {
        val text = input.trim()
        if (text.isEmpty() || busy) return

        input = ""
        error = null
        selectedAgent = null
        tools = emptyList()
        busy = true
        feedbackTarget = null
        feedbackRating = null
        feedbackError = null
        val assistantID = UUID.randomUUID().toString()
        messages = messages + listOf(
            ChatEntry(UUID.randomUUID().toString(), isUser = true, text = text),
            ChatEntry(assistantID, isUser = false, text = ""),
        )

        runJob = scope.launch {
            var agentName = "general"
            try {
                val id = api.startAgentRun(text)
                runID = id
                api.streamAgentRun(id).collect { event ->
                    if (event.type == "agent.selected") {
                        agentName = event.agent ?: "general"
                    }
                    apply(event, assistantID)
                    if (event.type == "run.completed") {
                        feedbackTarget = FeedbackTarget(runId = id, agent = agentName)
                    }
                }
            } catch (e: CancellationException) {
                throw e
            } catch (e: Exception) {
                error = e.userMessage()
            } finally {
                busy = false
                runID = null
                runJob = null
            }
        }
    }

    fun stop() {
        val id = runID
        if (id != null) {
            scope.launch {
                runCatching { api.cancelAgentRun(id) }
            }
        }
        runJob?.cancel()
        busy = false
    }

    fun rate(rating: Int) {
        val target = feedbackTarget ?: return
        feedbackError = null
        scope.launch {
            runCatching {
                api.submitAgentFeedback(target.runId, target.agent, rating)
            }.onSuccess {
                feedbackRating = rating
            }.onFailure {
                feedbackError = it.userMessage()
            }
        }
    }

    DisposableEffect(Unit) {
        onDispose {
            runJob?.cancel()
        }
    }

    Scaffold(
        modifier = modifier,
        topBar = {
            TopAppBar(title = { Text("Assistant", modifier = Modifier.semantics { heading() }) })
        },
    ) { innerPadding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding),
        ) {
            LazyColumn(
                modifier = Modifier
                    .weight(1f)
                    .semantics { liveRegion = LiveRegionMode.Polite },
                contentPadding = PaddingValues(horizontal = 16.dp, vertical = 16.dp),
                verticalArrangement = Arrangement.spacedBy(12.dp),
            ) {
                if (messages.isEmpty()) {
                    item {
                        Text(
                            text = "Ask about products, your account, or this app.",
                            style = MaterialTheme.typography.bodyMedium,
                        )
                    }
                }
                items(messages, key = { it.id }) { message ->
                    val text = if (message.text.isEmpty() && busy) {
                        "Thinking…"
                    } else {
                        message.text
                    }
                    if (text.isNotEmpty()) {
                        components.chatMessage(message.isUser, text)
                    }
                }
                items(tools, key = { it.id }) { tool ->
                    components.toolCall(
                        if (tool.isError) "${tool.name} (error)" else tool.name,
                        tool.detail,
                    )
                }
                if (feedbackTarget != null && !busy) {
                    item {
                        Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
                            components.feedbackButtons(feedbackRating) { rate(it) }
                            feedbackError?.let { message ->
                                Text(
                                    text = message,
                                    color = MaterialTheme.colorScheme.error,
                                    style = MaterialTheme.typography.bodySmall,
                                )
                            }
                        }
                    }
                }
                error?.let { message ->
                    item {
                        Text(
                            text = message,
                            color = MaterialTheme.colorScheme.error,
                            style = MaterialTheme.typography.bodySmall,
                        )
                    }
                }
            }

            val openProducts = onOpenProducts
            if (selectedAgent == "products" && openProducts != null) {
                TextButton(onClick = openProducts) {
                    Text("Open products")
                }
            }
            components.composer(
                input,
                busy,
                { input = it },
                { send() },
                { stop() },
            )
            Spacer(Modifier.height(8.dp))
        }
    }
}

private data class ChatEntry(
    val id: String,
    val isUser: Boolean,
    val text: String,
)

private data class ToolEntry(
    val id: String,
    val name: String,
    val detail: String,
    val isError: Boolean = false,
)

private data class FeedbackTarget(
    val runId: String,
    val agent: String,
)

private fun JsonElement?.asDisplayText(): String = when (this) {
    null -> ""
    is JsonPrimitive -> content
    else -> toString()
}
