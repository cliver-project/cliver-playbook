@Composable
fun PlaybookApp() {
    PlaybookTheme {
        val api = remember { ApiClient(BuildConfig.API_BASE_URL) }
{% if enabled('ui.mobile.auth') %}
        val context = LocalContext.current.applicationContext
        val tokenStore = remember { SecureTokenStore(context) }
        val authStore = remember { AuthStore(api, tokenStore) }

        DisposableEffect(api, authStore) {
            api.tokenProvider = authStore::token
            api.onUnauthorized = authStore::handleUnauthorized
            onDispose {
                api.tokenProvider = { null }
                api.onUnauthorized = null
            }
        }

        val authState by authStore.state.collectAsState()
        LaunchedEffect(authStore) { authStore.restoreSession() }

        when {
            authState.restoring && authState.token != null -> LoadingScreen()
            authState.token == null -> AuthScreen(
                store = authStore,
                title = "{{ project_title }}",
            )
            else -> AppShell(api = api, authStore = authStore)
        }
{% else %}
        AppShell(api = api)
{% endif %}
    }
}

{% if enabled('ui.mobile.auth') %}
@Composable
private fun LoadingScreen() {
    Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
        CircularProgressIndicator()
    }
}
{% endif %}

private sealed interface Destination {
{% if enabled('ui.agent.chat') %}
    data object Chat : Destination
{% endif %}
    data object Home : Destination
{% if enabled('ui.mobile.crud') %}
    data object ProductList : Destination
    data class ProductDetail(val id: Long) : Destination
    data class ProductEditor(val id: Long?) : Destination
{% endif %}
{% if enabled('ui.mobile.profile') %}
    data object Profile : Destination
{% endif %}
}

@OptIn(ExperimentalMaterial3AdaptiveApi::class)
@Composable
private fun AppShell(
    api: ApiClient,
{% if enabled('ui.mobile.auth') %}
    authStore: AuthStore,
{% endif %}
) {
{% if enabled('ui.mobile.auth') %}
    val authState by authStore.state.collectAsState()
{% endif %}
    val backStack = remember {
        mutableStateListOf<Destination>(
{% if enabled('ui.agent.chat') %}
            Destination.Chat,
{% else %}
            Destination.Home,
{% endif %}
        )
    }
    val current = backStack.last()
    BackHandler(enabled = backStack.size > 1) {
        backStack.removeAt(backStack.lastIndex)
    }
    val layoutType = {% if enabled('ui.mobile.responsive') %}rememberNavigationSuiteType(){% else %}NavigationSuiteType.NavigationBar{% endif %}

    NavigationSuiteScaffold(
        layoutType = layoutType,
        navigationSuiteItems = {
{% if enabled('ui.agent.chat') %}
            item(
                selected = current == Destination.Chat,
                onClick = { backStack.activate(Destination.Chat) },
                icon = { Icon(Icons.Filled.Email, contentDescription = null) },
                label = { Text("Assistant") },
            )
{% endif %}
            item(
                selected = current == Destination.Home,
                onClick = { backStack.activate(Destination.Home) },
                icon = { Icon(Icons.Filled.Home, contentDescription = null) },
                label = { Text("Home") },
            )
{% if enabled('ui.mobile.crud') %}
            item(
                selected = current == Destination.ProductList ||
                    current is Destination.ProductDetail ||
                    current is Destination.ProductEditor,
                onClick = { backStack.activate(Destination.ProductList) },
                icon = { Icon(Icons.Filled.ShoppingCart, contentDescription = null) },
                label = { Text("Products") },
            )
{% endif %}
{% if enabled('ui.mobile.profile') %}
            item(
                selected = current == Destination.Profile,
                onClick = { backStack.activate(Destination.Profile) },
                icon = { Icon(Icons.Filled.Person, contentDescription = null) },
                label = { Text("Profile") },
            )
{% endif %}
        },
    ) {
        when (current) {
{% if enabled('ui.agent.chat') %}
            Destination.Chat -> ChatScreen(
                api = api,
{% if enabled('ui.mobile.crud') %}
                onOpenProducts = { backStack.activate(Destination.ProductList) },
{% else %}
                onOpenProducts = null,
{% endif %}
            )
{% endif %}
            Destination.Home -> HomeScreen(
                title = "{{ project_title }}",
{% if enabled('ui.mobile.auth') %}
                user = authState.user,
                onSignOut = { authStore.logout() },
{% else %}
                user = null,
                onSignOut = null,
{% endif %}
{% if enabled('ui.mobile.crud') %}
                onOpenProducts = { backStack.activate(Destination.ProductList) },
{% endif %}
{% if enabled('ui.mobile.profile') %}
                onOpenProfile = { backStack.activate(Destination.Profile) },
{% endif %}
            )
{% if enabled('ui.mobile.crud') %}
            Destination.ProductList -> ProductListScreen(
                api = api,
                onOpenProduct = { id -> backStack.add(Destination.ProductDetail(id)) },
                onCreateProduct = { backStack.add(Destination.ProductEditor(null)) },
            )
            is Destination.ProductDetail -> ProductDetailScreen(
                api = api,
                productId = current.id,
                onBack = { backStack.removeAt(backStack.lastIndex) },
                onEdit = { backStack.add(Destination.ProductEditor(current.id)) },
                onDeleted = { backStack.activate(Destination.ProductList) },
            )
            is Destination.ProductEditor -> ProductEditorScreen(
                api = api,
                productId = current.id,
                onBack = { backStack.removeAt(backStack.lastIndex) },
                onSaved = { backStack.activate(Destination.ProductList) },
            )
{% endif %}
{% if enabled('ui.mobile.profile') %}
            Destination.Profile -> ProfileScreen(store = authStore)
{% endif %}
        }
    }
}

private fun MutableList<Destination>.activate(destination: Destination) {
    clear()
    add(destination)
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun HomeScreen(
    title: String,
    user: User?,
    onSignOut: (() -> Unit)?,
{% if enabled('ui.mobile.crud') %}
    onOpenProducts: () -> Unit,
{% endif %}
{% if enabled('ui.mobile.profile') %}
    onOpenProfile: () -> Unit,
{% endif %}
) {
    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Home") },
                actions = {
                    if (onSignOut != null) {
                        IconButton(onClick = onSignOut) {
                            Icon(
                                imageVector = Icons.AutoMirrored.Filled.ExitToApp,
                                contentDescription = "Sign out",
                            )
                        }
                    }
                },
            )
        },
    ) { innerPadding ->
        val horizontalPadding = if (currentLayoutMode() == LayoutMode.Compact) 16.dp else 32.dp
        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding),
            contentPadding = PaddingValues(horizontal = horizontalPadding, vertical = 16.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp),
        ) {
            item {
                Card(modifier = Modifier.fillMaxWidth()) {
                    Column(
                        modifier = Modifier.padding(20.dp),
                        verticalArrangement = Arrangement.spacedBy(8.dp),
                    ) {
                        Text(title, style = MaterialTheme.typography.headlineSmall)
                        Text(
                            text = if (user != null) {
                                "Signed in as ${user.displayName.ifBlank { user.username }}."
                            } else {
                                "Native Android shell generated from the project manifest."
                            },
                            style = MaterialTheme.typography.bodyMedium,
                        )
                    }
                }
            }
{% if enabled('ui.mobile.crud') or enabled('ui.mobile.profile') %}
            item {
                Text(
                    text = "Available in this project",
                    style = MaterialTheme.typography.titleMedium,
                )
            }
{% endif %}
{% if enabled('ui.mobile.crud') %}
            item {
                FeatureCard(
                    title = "Products",
                    description = "Browse and manage the reference product slice.",
                    icon = Icons.Filled.ShoppingCart,
                    onClick = onOpenProducts,
                )
            }
{% endif %}
{% if enabled('ui.mobile.profile') %}
            item {
                FeatureCard(
                    title = "Profile",
                    description = "Review and edit your account details.",
                    icon = Icons.Filled.Person,
                    onClick = onOpenProfile,
                )
            }
{% endif %}
{% if not enabled('ui.mobile.crud') and not enabled('ui.mobile.profile') %}
            item {
                Card(modifier = Modifier.fillMaxWidth()) {
                    Text(
                        text = "No feature screens are enabled in this project. " +
                            "Add profile or CRUD to the manifest and re-run the " +
                            "scaffolder.",
                        modifier = Modifier.padding(20.dp),
                        style = MaterialTheme.typography.bodyMedium,
                    )
                }
            }
{% endif %}
        }
    }
}

@Composable
private fun FeatureCard(
    title: String,
    description: String,
    icon: ImageVector,
    onClick: () -> Unit,
) {
    Card(onClick = onClick, modifier = Modifier.fillMaxWidth()) {
        Row(
            modifier = Modifier.padding(16.dp),
            verticalAlignment = Alignment.CenterVertically,
        ) {
            Icon(
                imageVector = icon,
                contentDescription = null,
                tint = MaterialTheme.colorScheme.primary,
            )
            Spacer(modifier = Modifier.width(16.dp))
            Column {
                Text(title, style = MaterialTheme.typography.titleMedium)
                Text(description, style = MaterialTheme.typography.bodyMedium)
            }
        }
    }
}
