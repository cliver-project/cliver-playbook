@pytest.mark.asyncio
async def test_product_update_rejects_explicit_null(client):
    headers = await _headers(client)
    created = await client.post(
        "/api/v1/products",
        json={"name": "Cannot null", "price_cents": 1},
        headers=headers,
    )
    assert created.status_code == 201, created.text
    product_id = created.json()["id"]

    response = await client.patch(
        f"/api/v1/products/{product_id}",
        json={"price_cents": None},
        headers=headers,
    )
    assert response.status_code == 422, response.text


@pytest.mark.asyncio
async def test_product_pagination_and_error_envelope(client):
    headers = await _headers(client)
    for index in range(3):
        created = await client.post(
            "/api/v1/products",
            json={"name": f"Paged {index}", "price_cents": index},
            headers=headers,
        )
        assert created.status_code == 201, created.text

    first = await client.get(
        "/api/v1/products", params={"limit": 1, "offset": 0}, headers=headers
    )
    second = await client.get(
        "/api/v1/products", params={"limit": 1, "offset": 1}, headers=headers
    )
    assert first.status_code == second.status_code == 200
    assert len(first.json()) == len(second.json()) == 1
    assert first.json()[0]["id"] != second.json()[0]["id"]

    missing = await client.get("/api/v1/products/999999999", headers=headers)
    assert missing.status_code == 404
    assert isinstance(missing.json().get("detail"), str)

    unauthorized = await client.get("/api/v1/products")
    assert unauthorized.status_code == 401
    assert isinstance(unauthorized.json().get("detail"), str)
