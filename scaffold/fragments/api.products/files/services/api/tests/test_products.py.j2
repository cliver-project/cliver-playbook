@pytest.mark.asyncio
async def test_product_ids_and_pagination_reject_out_of_range(client):
    headers = await _headers(client)
    huge = 2**63

    too_large_id = await client.get(f"/api/v1/products/{huge}", headers=headers)
    assert too_large_id.status_code == 422, too_large_id.text

    too_large_offset = await client.get(
        "/api/v1/products", params={"offset": huge}, headers=headers
    )
    assert too_large_offset.status_code == 422, too_large_offset.text


@pytest.mark.asyncio
async def test_product_text_rejects_nul_bytes(client):
    headers = await _headers(client)
    response = await client.post(
        "/api/v1/products",
        json={"name": "bad\u0000name"},
        headers=headers,
