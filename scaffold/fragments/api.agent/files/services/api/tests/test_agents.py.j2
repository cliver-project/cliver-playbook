@pytest.mark.asyncio
async def test_worker_runs_parallel_steps_with_isolated_sessions() -> None:
    from app.agents.events import EventStore
    from app.agents.runs import DatabaseRunStore
    from app.agents.worker import execute_run
    from app.settings import Settings
    from cliver_playbook.app.basic.db.session import open_session

    class SessionAgent(EchoAgent):
        def __init__(self, name: str, seen: list[int]) -> None:
            self.name = name
            self.seen = seen

        async def run(self, context: AgentContext) -> AgentResult:
            db = context.resources.get("db")
            self.seen.append(id(db))
            return AgentResult(
                agent=self.name,
                message=f"{self.name} done",
                data={"has_db": db is not None},
            )

    class GroupPlanner:
        async def plan(self, context, agents):
            return PlanDecision(
                steps=(
                    AgentIntent(name="first", payload={}, parallel_group=0),
                    AgentIntent(name="second", payload={}, parallel_group=0),
                ),
                planner="test",
            )

    seen: list[int] = []
    registry = AgentRegistry()
    registry.register(SessionAgent("first", seen))
    registry.register(SessionAgent("second", seen))
    coordinator = Coordinator(registry, planner=GroupPlanner())
    run_id = uuid.uuid4().hex

    async with open_session() as db:
        store = DatabaseRunStore(db)
        await store.create(run_id, message="run in parallel")
        await store.set_status(run_id, "running")

    await execute_run(
        run_id,
        message="run in parallel",
        user_id=None,
        session_id=None,
        settings=Settings(),
        coordinator=coordinator,
        already_claimed=True,
    )

    async with open_session() as db:
        record = await DatabaseRunStore(db).get(run_id)
        events = await EventStore(db).after(run_id, -1)

    assert record is not None and record.status == "completed"
    assert len(seen) == 2 and len(set(seen)) == 2
    selected = [event for event in events if event["type"] == "agent.selected"]
    assert {event["agent"] for event in selected} == {"first", "second"}
    assert {event.get("parallel_group") for event in selected} == {0}
    assert [event["sequence"] for event in events] == list(range(len(events)))
    assert events[-1]["type"] == "run.completed"


