@pytest.mark.asyncio
async def test_sessions_group_runs_and_return_replayable_history(client, auth_headers) -> None:
    headers = auth_headers if AUTH_ENABLED else {}
    session_id = uuid.uuid4().hex
    run_ids: list[str] = []
    for message in ("first turn", "second turn"):
        created = await client.post(
            "/api/v1/agent/runs",
            json={"message": message, "session_id": session_id},
            headers=headers,
        )
