async def test_run_executes_once_for_concurrent_streams(client, auth_headers, monkeypatch) -> None:
    gate = asyncio.Event()
    calls: list[str] = []
    monkeypatch.setattr("app.agents.factory.build_runner", lambda settings: GateRunner(gate, calls))

    created = await client.post(
        "/api/v1/agent/runs",
        json={"message": "only once"},
        headers=auth_headers,
    )
    run_id = created.json()["run_id"]

    async def consume() -> str:
        response = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
        assert response.status_code == 200, response.text
        return response.text

    first_task = asyncio.create_task(consume())
    second_task = asyncio.create_task(consume())
    await asyncio.sleep(0.15)
    gate.set()
    first_body, second_body = await asyncio.gather(first_task, second_task)

    assert first_body == second_body
    assert "run.completed" in first_body
    assert len(calls) == 1, "concurrent streams must not execute the run twice"


