async def test_agentcore_planner_selects_each_model_step() -> None:
    planner = AgentCorePlanner(
        FakePlanModel(
            PlanChoice(
                steps=[
                    PlanStepChoice(
                        agent="echo",
                        confidence=0.9,
                        reason="the request starts with echo",
                    ),
                    PlanStepChoice(agent="echo"),
                ]
