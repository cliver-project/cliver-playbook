@pytest.mark.asyncio
async def test_scoped_permission_callback_allows_declared_and_selected_mcp_tools():
    from cliver_core import tool
    from cliver_core.policy import DecisionAction, ToolCallContext, ToolCategory

    from app.agents.contracts import AgentToolkit
    from app.agents.permissions import build_permission_callback

    @tool(name="declared_tool", safety="safe")
    def declared_tool() -> list[dict]:
        return []

    context = _context("use tools")
    context.resources["mcp_servers"] = ["crm"]
    toolkit = AgentToolkit(system_prompt="", tools=[declared_tool], mcp_servers=[])
    callback = build_permission_callback(toolkit, context)

    allowed = await callback(
        ToolCallContext(
            tool_name="declared_tool",
            args={},
            server=None,
            category=ToolCategory.SAFE,
        )
    )
    assert allowed.action is DecisionAction.ALLOW

    unknown = await callback(
        ToolCallContext(
            tool_name="not_declared",
            args={},
            server=None,
            category=ToolCategory.SAFE,
        )
    )
    assert unknown.action is DecisionAction.DENY

    mcp_allowed = await callback(
        ToolCallContext(
            tool_name="mcp__crm__search",
            args={},
            server="crm",
            category=ToolCategory.ASK,
        )
    )
    assert mcp_allowed.action is DecisionAction.ALLOW

    mcp_denied = await callback(
        ToolCallContext(
            tool_name="mcp__other__search",
            args={},
            server="other",
            category=ToolCategory.ASK,
        )
    )
    assert mcp_denied.action is DecisionAction.DENY


