@pytest.mark.asyncio
async def test_coordinator_runs_a_multi_step_plan_with_handoff() -> None:
    class TwoStepPlanner:
        async def plan(self, context, agents):
            return PlanDecision(
                steps=(
                    AgentIntent(name="first", confidence=1.0, payload={}),
                    AgentIntent(name="second", confidence=1.0, payload={}),
                ),
                planner="test",
            )

    registry = AgentRegistry()
    registry.register(RecordingAgent("first"))
    registry.register(RecordingAgent("second"))
    coordinator = Coordinator(registry, planner=TwoStepPlanner())

    events = [event async for event in coordinator.stream(_context("do both"))]
    selected = [event for event in events if event["type"] == "agent.selected"]
    assert [event["agent"] for event in selected] == ["first", "second"]
    assert [event["step"] for event in selected] == [0, 1]
    results = [event for event in events if event["type"] == "agent.result"]
    assert [event["agent"] for event in results] == ["first", "second"]
    assert results[1]["data"]["prior"] == ["first"]
    assert events[-1]["type"] == "run.completed"


@pytest.mark.asyncio
async def test_multi_step_sources_are_isolated_per_agent() -> None:
    class TwoStepPlanner:
        async def plan(self, context, agents):
            return PlanDecision(
                steps=(
                    AgentIntent(name="first", confidence=1.0, payload={}),
                    AgentIntent(name="second", confidence=1.0, payload={}),
                ),
                planner="test",
            )

    class SourceAgent(EchoAgent):
        def __init__(self, name: str, source: str, captured: list[tuple[str, tuple]]):
            self.name = name
            self.source = source
            self.captured = captured

        async def run(self, context: AgentContext) -> AgentResult:
            sources = [*context.metadata.get("sources", ()), self.source]
            context.metadata["sources"] = sources
            self.captured.append((self.name, tuple(sources)))
            return AgentResult(agent=self.name, message=f"{self.name} done")

    captured: list[tuple[str, tuple]] = []
    registry = AgentRegistry()
    registry.register(SourceAgent("first", "orders", captured))
    registry.register(SourceAgent("second", "profile", captured))
    coordinator = Coordinator(registry, planner=TwoStepPlanner())
    context = AgentContext(
        run_id="run-sources",
        message="do both",
        metadata={"sources": ["crm"]},
    )

    events = [event async for event in coordinator.stream(context)]
    assert events[-1]["type"] == "run.completed"
    assert captured == [
        ("first", ("crm", "orders")),
        ("second", ("crm", "profile")),
    ]


