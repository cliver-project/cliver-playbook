@pytest.mark.asyncio
async def test_coordinator_delegates_to_a_sub_agent() -> None:
    registry = AgentRegistry()
    registry.register(EchoAgent())
    coordinator = Coordinator(registry, default_agent="echo")
    context = AgentContext(run_id="run-1", message="echo hello")
    events = [event async for event in coordinator.stream(context)]
    types = [event["type"] for event in events]
    assert types[0] == "run.started"
    assert "coordinator.plan" in types
    assert "agent.selected" in types
    assert "agent.result" in types
    assert "pipeline.evaluated" in types
    assert types[-1] == "run.completed"
    result = next(event for event in events if event["type"] == "agent.result")
    assert result["agent"] == "echo"
    assert result["message"] == "echo: echo hello"


