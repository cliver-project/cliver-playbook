@pytest.mark.asyncio
async def test_coordinator_runs_a_parallel_group_behind_a_barrier() -> None:
    class GroupPlanner:
        async def plan(self, context, agents):
            return PlanDecision(
                steps=(
                    AgentIntent(name="first", payload={}, parallel_group=0),
                    AgentIntent(name="second", payload={}, parallel_group=0),
                    AgentIntent(name="third", payload={}),
                ),
                planner="test",
            )

    started = {name: asyncio.Event() for name in ("first", "second")}
    order: list[str] = []

    class BarrierAgent(EchoAgent):
        def __init__(self, name: str) -> None:
            self.name = name

        async def run(self, context: AgentContext) -> AgentResult:
            order.append(f"{self.name}:start")
            started[self.name].set()
            await asyncio.wait_for(
                asyncio.gather(
                    *(event.wait() for other, event in started.items() if other != self.name)
                ),
                timeout=1.0,
            )
            order.append(f"{self.name}:end")
            return AgentResult(
                agent=self.name,
                message=f"{self.name} done",
                data={
                    "prior": [result.agent for result in context.prior_results],
                    "db": context.resources.get("db"),
                },
            )

    opened: list[object] = []
    closed: list[object] = []

    @asynccontextmanager
    async def scope():
        token = object()
        opened.append(token)
        try:
            yield {"db": token}
        finally:
            closed.append(token)

    registry = AgentRegistry()
    registry.register(BarrierAgent("first"))
    registry.register(BarrierAgent("second"))
    registry.register(RecordingAgent("third"))
    coordinator = Coordinator(registry, planner=GroupPlanner())
    context = AgentContext(run_id="run-parallel", message="do three", resource_scope=scope)

    events = [event async for event in coordinator.stream(context)]
    selected = [event for event in events if event["type"] == "agent.selected"]
    assert {event["agent"] for event in selected[:2]} == {"first", "second"}
    assert selected[2]["agent"] == "third"
    assert [event.get("parallel_group") for event in selected[:2]] == [0, 0]
    assert selected[2].get("parallel_group") is None
    assert set(order[:2]) == {"first:start", "second:start"}
    assert order[2:] == ["first:end", "second:end"] or order[2:] == [
        "second:end",
        "first:end",
    ]

    results = {event["agent"]: event for event in events if event["type"] == "agent.result"}
    assert results["first"]["data"]["prior"] == []
    assert results["second"]["data"]["prior"] == []
    assert results["first"]["data"]["db"] is not results["second"]["data"]["db"]
    assert results["third"]["data"]["prior"] == ["first", "second"]
    assert len(opened) == 3
    assert len(closed) == 3
    assert {id(token) for token in closed} == {id(token) for token in opened}
    assert [event["sequence"] for event in events] == list(range(len(events)))
    assert events[-1]["type"] == "run.completed"


@pytest.mark.asyncio
async def test_parallel_steps_require_a_resource_scope() -> None:
    class OtherEcho(EchoAgent):
        name = "second"

    class GroupPlanner:
