@pytest.mark.asyncio
async def test_products_agent_exposes_a_read_only_tool(client, auth_headers) -> None:
    from cliver_playbook.app.basic.db.session import open_session

    created = await client.post(
        "/api/v1/products",
        json={
            "name": "Tool product",
            "description": "Available to the agent",
            "price_cents": 990,
        },
        headers=auth_headers,
    )
    assert created.status_code == 201, created.text

    async with open_session() as db:
        toolkit = ProductsAgent().toolkit(
            AgentContext(
                run_id="run-tool",
                message="list products",
                resources={"db": db},
            )
        )
        names = {tool.name for tool in toolkit.tools}
        assert "products_list" in names
        tool = next(tool for tool in toolkit.tools if tool.name == "products_list")
        assert tool.execute_async is not None
        assert tool.safety == "safe"
        result = await tool.execute_async(limit=5)
    assert result
    assert "Tool product" in result[0]["text"]
