class GateRunner:
    """Test runner that blocks on a gate before yielding one result event."""

    def __init__(self, gate: asyncio.Event, calls: list[str] | None = None) -> None:
        self.gate = gate
        self.calls = calls

    async def run(self, agent, context):
        if self.calls is not None:
            self.calls.append(context.run_id)
        await self.gate.wait()
        yield {
            "type": "agent.result",
            "agent": agent.name,
            "message": "gated result",
            "data": {},
        }


async def _wait_status(run_id: str, expected: str, timeout: float = 5.0):
    from app.agents.runs import DatabaseRunStore
    from cliver_playbook.app.basic.db.session import open_session

    deadline = time.monotonic() + timeout
    while True:
        async with open_session() as db:
            record = await DatabaseRunStore(db).get(run_id)
        if record is not None and record.status == expected:
            return record
        if time.monotonic() >= deadline:
            pytest.fail(f"run {run_id} never reached status {expected!r}: {record}")
        await asyncio.sleep(0.05)


def _events_from_sse(body: str) -> list[dict]:
    events = []
    for block in body.split("\n\n"):
        data = "\n".join(line[5:] for line in block.splitlines() if line.startswith("data:"))
        if data:
            events.append(json.loads(data))
    return events


class EchoAgent:
    name = "echo"
    description = "Echo the message."
    capabilities = ("echo",)
    autonomy = AutonomyPolicy()
    pipeline = NoopPipeline()

    def can_handle(self, intent: AgentIntent) -> bool:
        return str(intent.payload.get("message", "")).lower().startswith("echo")

    def toolkit(self, context: AgentContext) -> AgentToolkit:
        return AgentToolkit(system_prompt="Echo the request.", tools=[])

    async def run(self, context: AgentContext) -> AgentResult:
        return AgentResult(agent=self.name, message=f"echo: {context.message}")


class FakePlanModel:
    def __init__(
        self,
        choice: PlanChoice | None = None,
        error: Exception | None = None,
    ) -> None:
        self.choice = choice
        self.error = error

    async def choose(self, message: str, agents: list[AgentDescriptor]) -> PlanChoice:
        if self.error is not None:
            raise self.error
        assert self.choice is not None
        return self.choice


class RecordingAgent(EchoAgent):
    """Appends the prior-step agents into its result for handoff assertions."""

    def __init__(self, name: str) -> None:
        self.name = name

    async def run(self, context: AgentContext) -> AgentResult:
        return AgentResult(
            agent=self.name,
            message=f"{self.name} done",
            data={"prior": [result.agent for result in context.prior_results]},
        )


class ToolRunner:
    """Yields tool and delta events so attribution can be asserted."""

    async def run(self, agent, context):
        yield {"type": "tool.call", "tool_call_id": "c1", "name": "t", "arguments": {}}
        yield {"type": "message.delta", "delta": "hi"}
        yield {"type": "agent.result", "agent": agent.name, "message": "done", "data": {}}


class FakePlanProvider(Provider):
    protocol = "openai"
    brand = "fake"

    def __init__(self, content: str) -> None:
        super().__init__("test-key", "http://127.0.0.1:9/v1")
        self.content = content

    async def chat(self, request) -> CLIverResponse:
        return CLIverResponse(message=CLIverMessage(role="assistant", content=self.content))

    async def stream(self, request) -> AsyncIterator[CLIverMessageChunk]:
        yield CLIverMessageChunk(content=self.content)


class ToolEchoAgent(EchoAgent):
    def toolkit(self, context: AgentContext) -> AgentToolkit:
        @tool(
            name="echo_tool",
            description="Echo text back to the caller.",
            safety="safe",
        )
        async def echo_tool(text: str) -> list[dict]:
            return [{"text": text}]

        return AgentToolkit(
            system_prompt="Use the echo tool when the request asks for it.",
            tools=[echo_tool],
        )


class FakeToolProvider(Provider):
    protocol = "openai"
    brand = "fake"

    def __init__(self) -> None:
        super().__init__("test-key", "http://127.0.0.1:9/v1")
        self.calls = 0

    async def chat(self, request) -> CLIverResponse:
        raise AssertionError("the streaming path is expected")

    async def stream(self, request) -> AsyncIterator[CLIverMessageChunk]:
        self.calls += 1
        if self.calls == 1:
            yield CLIverMessageChunk(
                native={
                    "role": "assistant",
                    "content": None,
                    "tool_calls": [
                        {
                            "id": "call-1",
                            "type": "function",
                            "function": {
                                "name": "echo_tool",
                                "arguments": '{"text": "hi"}',
                            },
                        }
                    ],
                }
            )
            return
        yield CLIverMessageChunk(content="Hello from tools")
        yield CLIverMessageChunk(native={"role": "assistant", "content": "Hello from tools"})


class FakeCore:
    def __init__(self) -> None:
        self.toolkit: AgentToolkit | None = None
        self.kwargs: dict[str, object] = {}
        self.user_input = ""

    async def stream(self, user_input: str, **kwargs: object) -> AsyncIterator[CLIverMessageChunk]:
        self.kwargs = kwargs
        self.user_input = user_input
        on_event = kwargs["on_event"]
        await on_event(
            ToolEvent(
                event=ToolEventType.START,
                tool_name="echo_tool",
                tool_call_id="call-1",
                args={"text": "hi"},
            )
        )
        await on_event(
            ToolEvent(
                event=ToolEventType.END,
                tool_name="echo_tool",
                tool_call_id="call-1",
                result="ok",
            )
        )
        await on_event(
            InferenceEvent(
                event=InferenceEventType.COMPLETED,
                model="test-model",
                provider="test-provider",
                data={"usage": {"input_tokens": 3, "output_tokens": 2}},
            )
        )
        yield CLIverMessageChunk(content="Hello ")
        yield CLIverMessageChunk(content="world")


class HandoffCore(FakeCore):
    """Fake AgentCore that requests a handoff through the optional tool."""

    def __init__(self, target: str = "second", reason: str = "needs it") -> None:
        self.target = target
        self.reason = reason
        self.toolkit: AgentToolkit | None = None

    async def stream(self, user_input: str, **kwargs: object) -> AsyncIterator[CLIverMessageChunk]:
        on_event = kwargs["on_event"]
        await on_event(
            ToolEvent(
                event=ToolEventType.START,
                tool_name="handoff_to_agent",
                tool_call_id="handoff-1",
                args={"target": self.target, "reason": self.reason},
            )
        )
        await on_event(
            ToolEvent(
                event=ToolEventType.END,
                tool_name="handoff_to_agent",
                tool_call_id="handoff-1",
                result="ok",
            )
        )
        yield CLIverMessageChunk(content="Handing this off.")


class BrokenCore:
    async def stream(self, user_input: str, **kwargs: object) -> AsyncIterator[CLIverMessageChunk]:
        raise RuntimeError("model down")
        yield CLIverMessageChunk()


