def test_skills_are_scoped_per_agent(tmp_path) -> None:
    from app.agents.core import build_skill_manager

    def write_skill(path, name, description):
        path.mkdir(parents=True)
        (path / "SKILL.md").write_text(
            f"---\nname: {name}\ndescription: {description}\n---\nUse it.\n",
            encoding="utf-8",
        )

    write_skill(tmp_path / "shared" / "greet", "greet", "Shared greeting skill.")
    write_skill(tmp_path / "products" / "price", "price", "Product pricing skill.")
    settings = Settings(_env_file=None, agent_skills_dir=str(tmp_path))

    general = build_skill_manager(settings, "general")
    products = build_skill_manager(settings, "products")
    assert general is not None and products is not None
    assert general.get_skill_names() == ["greet"]
    assert sorted(products.get_skill_names()) == ["greet", "price"]


@pytest.mark.asyncio
async def test_agentcore_runner_falls_back_before_emitting_output() -> None:
    runner = AgentCoreRunner(_runner_settings(), core_factory=_core_factory(BrokenCore()))
    events = [event async for event in runner.run(EchoAgent(), _context())]
    assert [event["type"] for event in events] == ["agent.result"]
    result = events[0]
    assert result["message"] == "echo: echo hello"
    assert result["data"]["mode"] == "deterministic"
    assert "model down" in result["data"]["fallback_reason"]


