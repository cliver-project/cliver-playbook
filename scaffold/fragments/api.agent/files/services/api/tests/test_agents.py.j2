@pytest.mark.asyncio
async def test_run_state_persists_across_sessions(client, auth_headers) -> None:
    from app.agents.runs import DatabaseRunStore
    from cliver_playbook.app.basic.db.session import open_session

    created = await client.post(
        "/api/v1/agent/runs",
        json={"message": "persist this run"},
        headers=auth_headers,
    )
    assert created.status_code == 202, created.text
    run_id = created.json()["run_id"]

    streamed = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
    assert streamed.status_code == 200, streamed.text

    record = await _wait_status(run_id, "completed")
    assert record.message == "persist this run"

    async with open_session() as db:
        again = await DatabaseRunStore(db).get(run_id)
    assert again is not None
    assert again.status == "completed"


@pytest.mark.asyncio
async def test_stream_replays_a_completed_run(client, auth_headers) -> None:
    created = await client.post(
        "/api/v1/agent/runs",
        json={"message": "replay me"},
        headers=auth_headers,
    )
    run_id = created.json()["run_id"]
    await _wait_status(run_id, "completed")

    first = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
    second = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
    assert first.status_code == 200, first.text
    assert second.text == first.text, "replay must be stable"
    assert "run.completed" in second.text


@pytest.mark.asyncio
async def test_stream_resumes_from_last_event_id(client, auth_headers) -> None:
    created = await client.post(
        "/api/v1/agent/runs",
        json={"message": "resume me"},
        headers=auth_headers,
    )
    run_id = created.json()["run_id"]
    await _wait_status(run_id, "completed")

    full = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
    events = _events_from_sse(full.text)
    sequences = [event["sequence"] for event in events]
    assert sequences == sorted(sequences)
    cut = sequences[2]

    resumed = await client.get(
        f"/api/v1/agent/runs/{run_id}/events",
        headers={**auth_headers, "Last-Event-ID": str(cut)},
    )
    assert resumed.status_code == 200, resumed.text
    resumed_events = _events_from_sse(resumed.text)
    assert [event["sequence"] for event in resumed_events] == [
        sequence for sequence in sequences if sequence > cut
    ]


@pytest.mark.asyncio
async def test_run_executes_once_for_concurrent_streams(client, auth_headers, monkeypatch) -> None:
    gate = asyncio.Event()
    calls: list[str] = []
    monkeypatch.setattr("app.api.agent.build_runner", lambda settings: GateRunner(gate, calls))

    created = await client.post(
        "/api/v1/agent/runs",
        json={"message": "only once"},
        headers=auth_headers,
    )
    run_id = created.json()["run_id"]

    async def consume() -> str:
        response = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
        assert response.status_code == 200, response.text
        return response.text

    first_task = asyncio.create_task(consume())
    second_task = asyncio.create_task(consume())
    await asyncio.sleep(0.15)
    gate.set()
    first_body, second_body = await asyncio.gather(first_task, second_task)

    assert first_body == second_body
    assert "run.completed" in first_body
    assert len(calls) == 1, "concurrent streams must not execute the run twice"


@pytest.mark.asyncio
async def test_cancel_during_run_persists_cancelled_event(
    client, auth_headers, monkeypatch
) -> None:
    gate = asyncio.Event()
    monkeypatch.setattr("app.api.agent.build_runner", lambda settings: GateRunner(gate))

    created = await client.post(
        "/api/v1/agent/runs",
        json={"message": "cancel while running"},
        headers=auth_headers,
    )
    run_id = created.json()["run_id"]
    await _wait_status(run_id, "running")

    cancelled = await client.post(f"/api/v1/agent/runs/{run_id}/cancel", headers=auth_headers)
    assert cancelled.status_code == 202, cancelled.text

    streamed = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
    assert streamed.status_code == 200, streamed.text
    assert '"code":"cancelled"' in streamed.text

    record = await _wait_status(run_id, "cancelled")
    assert record.cancelled is True


@pytest.mark.asyncio
async def test_orphaned_running_run_is_failed(client, auth_headers) -> None:
    from sqlalchemy import text

    from app.agents.runs import DatabaseRunStore
    from cliver_playbook.app.basic.db.session import open_session

    run_id = uuid.uuid4().hex
    async with open_session() as db:
        await DatabaseRunStore(db).create(run_id, message="orphaned run", user_id=None)
        await DatabaseRunStore(db).set_status(run_id, "running")
        await db.execute(
            text(
                "UPDATE agent_runs SET updated_at = now() - interval '600 seconds' "
                "WHERE run_id = :run_id"
            ),
            {"run_id": run_id},
        )
        await db.commit()

    streamed = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
    assert streamed.status_code == 200, streamed.text
    assert '"code":"orphaned"' in streamed.text
    await _wait_status(run_id, "failed")


@pytest.mark.skipif(not AUTH_ENABLED, reason="authentication is not enabled")
@pytest.mark.asyncio
async def test_run_is_scoped_to_its_owner(client, auth_headers) -> None:
    created = await client.post(
        "/api/v1/agent/runs",
        json={"message": "private run"},
        headers=auth_headers,
    )
    assert created.status_code == 202, created.text
    run_id = created.json()["run_id"]

    username = f"other_{uuid.uuid4().hex[:10]}"
    registered = await client.post(
        "/api/v1/auth/register",
        json={"username": username, "password": "secret123"},
    )
    assert registered.status_code == 201, registered.text
    other_headers = {"Authorization": f"Bearer {registered.json()['token']}"}

    streamed = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=other_headers)
    assert streamed.status_code == 403
    cancelled = await client.post(f"/api/v1/agent/runs/{run_id}/cancel", headers=other_headers)
    assert cancelled.status_code == 403


@pytest.mark.asyncio
async def test_http_run_streams_a_multi_step_plan(client, auth_headers, monkeypatch) -> None:
    class TwoStepPlanner:
        async def plan(self, context, agents):
            return PlanDecision(
                steps=(
                    AgentIntent(name="general", confidence=1.0, payload={}),
                    AgentIntent(name="general", confidence=1.0, payload={}),
                ),
                planner="test",
            )

    monkeypatch.setattr("app.api.agent.build_planner", lambda settings: TwoStepPlanner())
    monkeypatch.setattr("app.api.agent.build_runner", lambda settings: ToolRunner())

    created = await client.post(
        "/api/v1/agent/runs",
        json={"message": "run two steps"},
        headers=auth_headers,
    )
    run_id = created.json()["run_id"]
    streamed = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
    assert streamed.status_code == 200, streamed.text
    events = _events_from_sse(streamed.text)

    selected = [event for event in events if event["type"] == "agent.selected"]
    assert [event["step"] for event in selected] == [0, 1]
    tool_calls = [event for event in events if event["type"] == "tool.call"]
    assert tool_calls and all(event["agent"] == "general" for event in tool_calls)
    assert events[-1]["type"] == "run.completed"

    replay = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
    assert replay.text == streamed.text


