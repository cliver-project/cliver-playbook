@pytest.mark.asyncio
async def test_coordinator_runs_a_direct_handoff_before_the_next_plan_step() -> None:
    class HandoffAgent(EchoAgent):
        def __init__(self, name: str) -> None:
            self.name = name

        async def run(self, context: AgentContext) -> AgentResult:
            return AgentResult(
                agent=self.name,
                message="first hands off",
                data={"prior": [result.agent for result in context.prior_results]},
                handoff=AgentHandoff(
                    target="second",
                    reason="needs the second business point",
                    payload={"case": "handoff-1"},
                ),
            )

    class CaptureAgent(RecordingAgent):
        def __init__(self, name: str, captured: list[AgentContext]) -> None:
            super().__init__(name)
            self.captured = captured

        async def run(self, context: AgentContext) -> AgentResult:
            self.captured.append(context)
            return await super().run(context)

    class HandoffPlanner:
        async def plan(self, context, agents):
            return PlanDecision(
                steps=(
                    AgentIntent(name="first", payload={}),
                    AgentIntent(name="third", payload={}),
                ),
                planner="test",
            )

    captured: list[AgentContext] = []
    registry = AgentRegistry()
    registry.register(HandoffAgent("first"))
    registry.register(CaptureAgent("second", captured))
    registry.register(RecordingAgent("third"))
    coordinator = Coordinator(registry, planner=HandoffPlanner())

    events = [event async for event in coordinator.stream(_context("do the chain"))]
    handoff = next(event for event in events if event["type"] == "agent.handoff")
    assert handoff["agent"] == "first"
    assert handoff["target"] == "second"
    assert handoff["reason"] == "needs the second business point"
    assert handoff["depth"] == 1
    assert handoff["step"] == 0

    selected = [event for event in events if event["type"] == "agent.selected"]
    assert [event["agent"] for event in selected] == ["first", "second", "third"]
    assert selected[1]["reason"] == "handoff:first"

    results = {event["agent"]: event for event in events if event["type"] == "agent.result"}
    assert results["second"]["data"]["prior"] == ["first"]
    assert results["third"]["data"]["prior"] == ["first", "second"]
    assert captured[0].metadata["handoff"]["from"] == "first"
    assert captured[0].metadata["handoff"]["payload"] == {"case": "handoff-1"}
    assert events[-1]["type"] == "run.completed"


