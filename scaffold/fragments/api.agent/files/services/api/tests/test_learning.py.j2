def _policy(**overrides):
    values = {
        "allowed_sources": ("products",),
        "evaluation_metric": "products.answer.quality",
        "evaluation_threshold": 0.6,
        "improvement_mode": "proposal",
        "retention_days": 30,
    }
    values.update(overrides)
    return AutonomyPolicy(**values)


def _context(message="list products", *, sources=("products",), step=0):
    return AgentContext(
        run_id=uuid.uuid4().hex,
        message=message,
        user_id=1,
        step=step,
        metadata={"sources": list(sources)},
    )


def _result(message="Found 2 product(s).", **data):
    return AgentResult(
        agent="products",
        message=message,
        data={"mode": "agentcore", **data},
    )


@pytest.mark.asyncio
async def test_observe_redacts_sensitive_data_and_enforces_sources(db_session):
    policy = _policy()
    context = _context(
        "my email is a@b.com; call (555) 123-4567",
        sources=("products",),
    )
    context.session_id = "session-abc"
    result = _result(
        "contact c@d.com; ssn 123-45-6789",
        email="e@f.com",
        mobile=5551234567,
        price_cents=100,
        nested={"phone": "+1 555 123 4567"},
    )
    experience = await observe_experience(db_session, policy, context, result)

    assert experience is not None
    assert "a@b.com" not in experience.message
    assert "555" not in experience.message
    assert "c@d.com" not in experience.result_message
    assert "123-45-6789" not in experience.result_message
    assert experience.result_data["email"] == "[redacted]"
    assert experience.result_data["mobile"] == "[redacted]"
    assert experience.result_data["nested"]["phone"] == "[redacted]"
    assert experience.result_data["price_cents"] == 100
    assert experience.session_id != "session-abc"
    assert len(experience.session_id or "") == 32

    denied = await observe_experience(
        db_session,
        policy,
        _context(sources=("crm",)),
        _result("should not be stored"),
    )
    assert denied is None

    undeclared = await observe_experience(
        db_session,
        policy,
        _context(sources=()),
        _result("must not be stored without a declared source"),
    )
    assert undeclared is None


@pytest.mark.asyncio
async def test_feedback_lowers_the_evaluation_below_the_launch_bar(db_session):
    policy = _policy()
    context = _context()
    experience = await observe_experience(db_session, policy, context, _result())
    assert experience is not None

    baseline = await evaluate_experience(db_session, policy, experience)
    assert baseline.passed is True
    assert baseline.score >= policy.evaluation_threshold

    feedback = await record_feedback(
        db_session,
        experience=experience,
        user_id=1,
        rating=1,
        comment="the answer missed the price",
    )
    assert feedback.rating == 1

    after = await evaluate_experience(db_session, policy, experience)
    assert after.score < policy.evaluation_threshold
    assert after.passed is False


