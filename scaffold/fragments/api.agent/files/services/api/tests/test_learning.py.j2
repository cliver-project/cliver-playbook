@pytest.mark.asyncio
async def test_low_evaluations_create_one_pending_proposal_and_approval_applies_it(
    db_session,
):
    policy = _policy()
    proposal = None
    for _ in range(3):
        experience = await observe_experience(
            db_session, policy, _context(), _result("unhelpful answer")
        )
        assert experience is not None
        await record_feedback(
            db_session, experience=experience, user_id=1, rating=1, comment="wrong"
        )
        await evaluate_experience(db_session, policy, experience)
        proposal = await maybe_create_proposal(db_session, policy, "products")

    assert proposal is not None
    assert proposal.status == "pending"
    assert proposal.kind == "prompt"
    assert proposal.evidence["samples"] == 3
    assert proposal.patch["prompt_append"]
    assert await maybe_create_proposal(db_session, policy, "products") is None

    created_events = (
        await db_session.scalars(
            select(AgentImprovementEvent).where(AgentImprovementEvent.proposal_id == proposal.id)
        )
    ).all()
    assert [event.action for event in created_events] == ["created"]

    applied, was_applied = await approve_proposal(db_session, proposal.id, actor_id=7)
    assert was_applied is True
    assert applied.status == "applied"
    overlay = await load_prompt_overlay(db_session, "products")
    assert overlay.strip()
    assert overlay == applied.patch["prompt_append"]
    audit_events = (
        await db_session.scalars(
            select(AgentImprovementEvent)
            .where(AgentImprovementEvent.proposal_id == proposal.id)
            .order_by(AgentImprovementEvent.id)
        )
    ).all()
    assert [event.action for event in audit_events] == [
        "created",
        "gate_skipped",
        "applied",
    ]
    assert audit_events[-1].actor_id == 7


@pytest.mark.asyncio
async def test_rejecting_a_proposal_does_not_change_the_agent_overlay(db_session):
    policy = _policy()
    for _ in range(3):
        experience = await observe_experience(
            db_session, policy, _context(), _result("unhelpful answer")
        )
        assert experience is not None
        await record_feedback(
            db_session, experience=experience, user_id=1, rating=1, comment="wrong"
        )
        await evaluate_experience(db_session, policy, experience)
    proposal = await maybe_create_proposal(db_session, policy, "products")
    assert proposal is not None

    rejected = await reject_proposal(db_session, proposal.id, actor_id=7, note="not safe")
    assert rejected.status == "rejected"
    assert await load_prompt_overlay(db_session, "products") == ""
    events = (
        await db_session.scalars(
            select(AgentImprovementEvent)
            .where(AgentImprovementEvent.proposal_id == proposal.id)
            .order_by(AgentImprovementEvent.id)
        )
    ).all()
    assert [event.action for event in events] == ["created", "rejected"]
    assert events[-1].note == "not safe"


async def _seed_low_evaluations(db_session, policy, count: int = 3) -> None:
    for index in range(count):
        experience = await observe_experience(
            db_session,
            policy,
            _context(f"list products attempt {index}"),
            _result(f"unhelpful answer {index}"),
        )
        assert experience is not None
        await record_feedback(
            db_session,
            experience=experience,
            user_id=1,
            rating=1,
            comment=f"the answer was wrong ({index})",
        )
        await evaluate_experience(db_session, policy, experience)


class _FakeProposalGenerator:
    def __init__(self, draft: ProposalDraft) -> None:
        self.draft_value = draft
        self.calls: list[dict] = []

    async def draft(self, *, agent, metric, threshold, evidence):
        self.calls.append(
            {
                "agent": agent,
                "metric": metric,
                "threshold": threshold,
                "evidence": evidence,
            }
        )
        return self.draft_value


class _FailingProposalGenerator:
    async def draft(self, *, agent, metric, threshold, evidence):
        raise RuntimeError("distillation provider is down")


@pytest.mark.asyncio
async def test_model_generator_distills_a_proposal_from_recent_experience(db_session):
    policy = _policy()
    await _seed_low_evaluations(db_session, policy)
    generator = _FakeProposalGenerator(
        ProposalDraft(
            title="Use prices explicitly",
            rationale="Users repeatedly report missing prices.",
            prompt_append="Always include the price when describing a product.",
        )
    )

    proposal = await maybe_create_proposal(db_session, policy, "products", generator=generator)

    assert proposal is not None
    assert proposal.patch["prompt_append"].startswith("Always include the price")
    assert proposal.title == "Use prices explicitly"
    assert proposal.evidence["proposal_source"] == "agentcore"
    assert generator.calls
    assert generator.calls[0]["agent"] == "products"
    assert generator.calls[0]["metric"] == policy.evaluation_metric
    assert generator.calls[0]["evidence"]
    assert generator.calls[0]["evidence"][0]["feedback"]


@pytest.mark.asyncio
async def test_model_generator_failure_falls_back_to_deterministic(db_session):
    policy = _policy()
    await _seed_low_evaluations(db_session, policy)

    proposal = await maybe_create_proposal(
        db_session, policy, "products", generator=_FailingProposalGenerator()
    )

    assert proposal is not None
    assert proposal.patch["prompt_append"] == DEFAULT_PROMPT_APPEND
    assert proposal.evidence["proposal_source"] == "deterministic_fallback"
    assert "provider is down" in proposal.evidence["generator_fallback_reason"]


