async def _pending_proposal(
    db_session, *, agent: str = "products", prompt: str = "Always cite the price."
) -> AgentImprovement:
    proposal = AgentImprovement(
        id=uuid.uuid4().hex,
        agent=agent,
        kind="prompt",
        status="pending",
        title=f"Improve {agent}",
        rationale="test proposal",
        patch={"prompt_append": prompt},
        evidence={"samples": 3},
    )
    db_session.add(proposal)
    await db_session.commit()
    await db_session.refresh(proposal)
    return proposal


class _OverlayRunner:
    def __init__(self, *, baseline: str, candidate: str, marker: str = "cite") -> None:
        self.baseline = baseline
        self.candidate = candidate
        self.marker = marker

    async def run(self, message: str, overlay: str) -> str:
        return self.candidate if self.marker in overlay else self.baseline


