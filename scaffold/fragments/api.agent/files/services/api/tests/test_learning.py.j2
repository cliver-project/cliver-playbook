async def _products_run(client, auth_headers) -> str:
    created = await client.post(
        "/api/v1/agent/runs",
        json={"message": "list products"},
        headers=auth_headers,
    )
    assert created.status_code == 202, created.text
    run_id = created.json()["run_id"]
    streamed = await client.get(f"/api/v1/agent/runs/{run_id}/events", headers=auth_headers)
    assert streamed.status_code == 200, streamed.text
    assert "event: run.completed" in streamed.text
    return run_id


async def _negative_proposal_id(client, auth_headers) -> str:
    proposal_id = None
    for _ in range(3):
        run_id = await _products_run(client, auth_headers)
        response = await client.post(
            f"/api/v1/agent/runs/{run_id}/feedback",
            json={"agent": "products", "rating": 1, "comment": "wrong"},
            headers=auth_headers,
        )
        assert response.status_code == 201, response.text
        proposal = response.json()["proposal"]
        if proposal is not None:
            proposal_id = proposal["id"]
    assert proposal_id is not None
    return proposal_id


