@pytest.mark.asyncio
async def test_golden_set_versions_are_immutable_and_can_be_reactivated(db_session):
    await create_golden_case(
        db_session,
        agent="products",
        name="first case",
        message="list products",
        expected_contains=["Found"],
    )
    first = await publish_golden_set(db_session, "products", actor_id=7, note="first")
    assert first.is_active is True

    await create_golden_case(
        db_session,
        agent="products",
        name="second case",
        message="list products again",
        expected_contains=["product"],
    )
    second = await publish_golden_set(db_session, "products", actor_id=7, note="second")
    assert second.version == 2
    assert second.is_active is True
    active = await active_golden_cases(db_session, "products")
    assert active is not None
    assert len(active) == 2

    await activate_golden_version(db_session, first.id)
    active = await active_golden_cases(db_session, "products")
    assert active is not None
    assert len(active) == 1
    assert active[0].name == "first case"


@pytest.mark.asyncio
async def test_prompt_config_versions_can_be_rolled_back(db_session):
    first = await _pending_proposal(db_session, prompt="First guidance.")
    await approve_proposal(db_session, first.id, actor_id=7)
    second = await _pending_proposal(db_session, prompt="Second guidance.")
    await approve_proposal(db_session, second.id, actor_id=7)

    versions = await list_config_versions(db_session, "products")
    assert [version.version for version in versions] == [2, 1]
    assert versions[0].prompt_overlay == ("First guidance.\n\nSecond guidance.")

    config = await rollback_config(db_session, "products", 1, actor_id=7, note="restore first")
    assert config.version == 3
    assert config.prompt_overlay == "First guidance."
    restored = await list_config_versions(db_session, "products")
    assert [version.version for version in restored] == [3, 2, 1]
    assert restored[0].note == "restore first"


