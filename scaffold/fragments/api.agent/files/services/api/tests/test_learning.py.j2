@pytest.mark.asyncio
async def test_three_negative_feedbacks_create_a_reviewer_gated_proposal(
    client, auth_headers, app_instance
):
    proposal_id = None
    for _ in range(3):
        run_id = await _products_run(client, auth_headers)
        response = await client.post(
            f"/api/v1/agent/runs/{run_id}/feedback",
            json={"agent": "products", "rating": 1, "comment": "wrong"},
            headers=auth_headers,
        )
        assert response.status_code == 201, response.text
        proposal = response.json()["proposal"]
        if proposal is not None:
            proposal_id = proposal["id"]
    assert proposal_id is not None

    denied = await client.get("/api/v1/agent/proposals", headers=auth_headers)
    assert denied.status_code == 403, denied.text

    from cliver_playbook.app.user.auth.dependencies import Viewer, get_current_user

    async def _admin_viewer():
        return Viewer(
            user_id=999999,
            username="reviewer",
            display_name="Reviewer",
            must_change_password=False,
            role_codes=frozenset({"admin"}),
            permissions=frozenset({"*"}),
        )

    app_instance.dependency_overrides[get_current_user] = _admin_viewer
    try:
        listed = await client.get("/api/v1/agent/proposals", headers=auth_headers)
        assert listed.status_code == 200, listed.text
        proposals = listed.json()["proposals"]
        assert any(proposal["id"] == proposal_id for proposal in proposals)

        approved = await client.post(
            f"/api/v1/agent/proposals/{proposal_id}/approve",
            headers=auth_headers,
        )
        assert approved.status_code == 200, approved.text
        body = approved.json()
        assert body["applied"] is True
        assert body["proposal"]["status"] == "applied"
    finally:
        app_instance.dependency_overrides.clear()


@pytest.mark.asyncio
async def test_golden_case_api_round_trip_and_reviewer_gate(client, auth_headers, app_instance):
    payload = {
        "agent": "products",
        "name": "products list answer",
        "message": "list products",
        "expected_contains": ["Found"],
    }
    denied = await client.post("/api/v1/agent/golden-cases", json=payload, headers=auth_headers)
    assert denied.status_code == 403, denied.text

    async with _admin_reviewer(app_instance):
        created = await client.post(
            "/api/v1/agent/golden-cases", json=payload, headers=auth_headers
        )
        assert created.status_code == 201, created.text
        case_id = created.json()["id"]
        listed = await client.get("/api/v1/agent/golden-cases?agent=products", headers=auth_headers)
        assert listed.status_code == 200, listed.text
        assert [case["id"] for case in listed.json()["cases"]] == [case_id]
        deleted = await client.delete(f"/api/v1/agent/golden-cases/{case_id}", headers=auth_headers)
        assert deleted.status_code == 200, deleted.text
        empty = await client.get("/api/v1/agent/golden-cases?agent=products", headers=auth_headers)
        assert empty.json()["cases"] == []


