@router.get("/runtime", response_model=AgentRuntimeStatusRead)
{% if enabled('api.auth') %}
async def get_agent_runtime_status(
    _viewer: Viewer = _VIEWER,
) -> AgentRuntimeStatusRead:
{% else %}
async def get_agent_runtime_status() -> AgentRuntimeStatusRead:
{% endif %}
{% if enabled('api.auth') %}
    _require_reviewer(_viewer)
{% endif %}
    settings = get_settings()
    model_configured = bool(settings.agent_llm_model.strip())
    mcp_servers: list[str] = []
    if settings.agent_mcp_enabled:
        try:
            mcp_servers = sorted(discover_servers(settings).servers)
        except Exception:  # the status page must stay available
            logger.exception("Could not list MCP servers for the runtime status")
    return AgentRuntimeStatusRead(
        model_configured=model_configured,
        judge_enabled=settings.agent_judge_enabled,
        mcp_enabled=settings.agent_mcp_enabled,
        compaction_enabled=settings.agent_compaction_enabled,
        tool_permission_mode=settings.agent_tool_permission_mode,
        system_one_provider=settings.agent_system_one_provider,
        model_provider=((settings.agent_llm_provider or "custom") if model_configured else ""),
        model_name=settings.agent_llm_model if model_configured else "",
        mcp_servers=mcp_servers,
    )


