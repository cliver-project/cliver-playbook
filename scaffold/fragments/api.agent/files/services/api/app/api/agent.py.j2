    note = payload.note if payload is not None else ""
    try:
        await rollback_config(db, name, version, actor_id=actor_id, note=note)
    except VersionError as exc:
        await db.rollback()
        raise HTTPException(status_code=exc.status_code, detail=exc.message) from exc
    return AgentLearningSummaryRead(**await agent_learning_summary(db, name))


@router.post(
    "/proposals/{proposal_id}/approve",
    response_model=AgentProposalDecision,
)
async def approve_agent_proposal(
    proposal_id: str,
{% if enabled('api.auth') %}
    _viewer: Viewer = _VIEWER,
{% endif %}
    db: AsyncSession = Depends(get_db),
) -> AgentProposalDecision:
{% if enabled('api.auth') %}
    _require_reviewer(_viewer)
    actor_id = _viewer.user_id
{% else %}
    actor_id = None
{% endif %}
    existing = await get_proposal(db, proposal_id)
    if existing is None:
        raise HTTPException(status_code=404, detail="Proposal not found")
    agent = registry.get(existing.agent)
    settings = get_settings()
    runner = build_regression_runner(settings, agent, db) if agent is not None else None
    judge = build_golden_case_judge(settings)
    min_score = agent.autonomy.regression_min_score if agent is not None else 0.8
    try:
        proposal, applied = await approve_proposal(
            db,
            proposal_id,
            actor_id,
            regression_runner=runner,
            regression_min_score=min_score,
            regression_judge=judge,
            regression_judge_required=settings.agent_judge_enabled,
        )
    except LearningError as exc:
        await db.rollback()
        raise HTTPException(status_code=exc.status_code, detail=exc.message) from exc
    report = await get_regression_run(db, proposal.id)
    return AgentProposalDecision(
        proposal=_proposal_read(proposal),
        applied=applied,
        requires_manual_apply=not applied,
        regression=_regression_read(report) if report is not None else None,
    )


