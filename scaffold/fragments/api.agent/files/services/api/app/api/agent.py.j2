def _require_reviewer(viewer: Viewer) -> None:
    """Approval is a privileged action; register ``agent:improve`` in RBAC.

    The bootstrap admin wildcard works without a project-specific permission.
    Until a project registers the code, only the admin role can review.
    """
    if viewer.has("agent:improve") or "admin" in viewer.role_codes:
        return
    raise HTTPException(status_code=403, detail="Reviewer permission required")
