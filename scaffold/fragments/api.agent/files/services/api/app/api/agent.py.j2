def _run_store(db: AsyncSession) -> RunStore:
    """The project's durable run store for one request session."""
    return DatabaseRunStore(db)


def _sse(event: dict) -> str:
    """One SSE frame; ``id`` carries the sequence for Last-Event-ID resume."""
    lines = []
    sequence = event.get("sequence")
    if isinstance(sequence, int):
        lines.append(f"id: {sequence}")
    lines.append(f"event: {event['type']}")
    lines.append(f"data: {json.dumps(event, separators=(',', ':'))}")
    return "\n".join(lines) + "\n\n"


def _descriptor(agent: SubAgent) -> AgentDescriptorRead:
    return AgentDescriptorRead(
        name=agent.name,
        description=agent.description,
        capabilities=list(agent.capabilities),
        autonomy_mode=agent.autonomy.improvement_mode,
        has_pipeline=agent.pipeline is not None,
    )


