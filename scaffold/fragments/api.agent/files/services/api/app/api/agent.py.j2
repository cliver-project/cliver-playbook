@router.get("/runs/{run_id}/events")
async def stream_run(
    run_id: str,
    request: Request,
    last_event_id: int = Header(default=-1, alias="Last-Event-ID", ge=0, le=2**31 - 1),
{% if enabled('api.auth') %}
    _viewer: Viewer = _VIEWER,
{% endif %}
) -> StreamingResponse:
    settings = get_settings()
    store_db = open_session()
    store = DatabaseRunStore(store_db)
    events = EventStore(store_db)
    try:
        record = await store.get(run_id)
    except BaseException:
        await store_db.close()
        raise
    if record is None:
        await store_db.close()
        raise HTTPException(status_code=404, detail="Run not found")
{% if enabled('api.auth') %}
    if record.user_id is not None and record.user_id != _viewer.user_id:
        await store_db.close()
        raise HTTPException(status_code=403, detail="Run belongs to another user")
{% endif %}

    subscription = broadcaster.subscribe(run_id)

    async def events_stream():
        try:
            last = last_event_id
            last_output = time.monotonic()
            while True:
                payloads = await events.after(run_id, last)
                if payloads:
                    for payload in payloads:
                        yield _sse(payload)
                        last = payload["sequence"]
                        last_output = time.monotonic()
                        if payload.get("type") in TERMINAL_EVENT_TYPES:
                            return
                    continue
                current = await store.get(run_id)
                if current is not None and current.status in TERMINAL_STATUSES:
                    return
                if (
                    current is not None
                    and current.status in {"queued", "running"}
                    and await store.mark_orphaned_if_stale(
                        run_id, settings.agent_run_orphan_seconds
                    )
                ):
                    # The worker's process died mid-run: fail once, never retry
                    # (tools may have had side effects).
                    await events.persist(
                        run_id,
                        {
                            "type": "run.failed",
                            "code": "orphaned",
                            "message": "The run stopped without completing; it was marked failed.",
                        },
                    )
                    broadcaster.notify(run_id)
                    continue
                try:
                    await asyncio.wait_for(
                        subscription.wait(), timeout=settings.agent_event_poll_seconds
                    )
                except TimeoutError:
                    pass
                subscription.clear()
                if time.monotonic() - last_output >= settings.agent_sse_keepalive_seconds:
                    yield ": keepalive\n\n"
                    last_output = time.monotonic()
        finally:
            broadcaster.unsubscribe(run_id, subscription)
            await store_db.close()

    return StreamingResponse(
        events_stream(),
        media_type="text/event-stream",
        headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"},
    )


@router.post("/runs/{run_id}/cancel", status_code=status.HTTP_202_ACCEPTED)
async def cancel_run(
    run_id: str,
{% if enabled('api.auth') %}
    _viewer: Viewer = _VIEWER,
{% endif %}
    db: AsyncSession = Depends(get_db),
) -> dict[str, str]:
    store = _run_store(db)
    record = await store.get(run_id)
    if record is None:
        raise HTTPException(status_code=404, detail="Run not found")
{% if enabled('api.auth') %}
    if record.user_id is not None and record.user_id != _viewer.user_id:
        raise HTTPException(status_code=403, detail="Run belongs to another user")
{% endif %}
    cancelled = await store.cancel(run_id)
    final = cancelled.status if cancelled is not None else record.status
    return {"run_id": run_id, "status": final if final != "running" else "cancelling"}


@router.post(
    "/runs/{run_id}/feedback",
    response_model=AgentFeedbackCreated,
    status_code=status.HTTP_201_CREATED,
)
async def submit_feedback(
    run_id: str,
    payload: AgentFeedbackRequest,
{% if enabled('api.auth') %}
    _viewer: Viewer = _VIEWER,
{% endif %}
    db: AsyncSession = Depends(get_db),
) -> AgentFeedbackCreated:
    """Attach an outcome rating; evaluation and proposal logic run now."""
    record = await _run_store(db).get(run_id)
    if record is None:
        raise HTTPException(status_code=404, detail="Run not found")
{% if enabled('api.auth') %}
    if record.user_id is not None and record.user_id != _viewer.user_id:
        raise HTTPException(status_code=403, detail="Run belongs to another user")
{% endif %}
    agent = registry.get(payload.agent)
    if agent is None:
        raise HTTPException(status_code=404, detail="Agent not found")
    experience = await find_experience(db, run_id=run_id, agent=payload.agent, step=payload.step)
    if experience is None:
        raise HTTPException(status_code=404, detail="No observed experience for this run")
{% if enabled('api.auth') %}
    user_id = _viewer.user_id
{% else %}
    user_id = None
{% endif %}
    try:
        feedback = await record_feedback(
            db,
            experience=experience,
            user_id=user_id,
            rating=payload.rating,
            comment=payload.comment,
        )
        evaluation = await evaluate_experience(db, agent.autonomy, experience)
        proposal = await maybe_create_proposal(
            db,
            agent.autonomy,
            agent.name,
            generator=build_proposal_generator(get_settings()),
        )
        if proposal is None:
            proposal = await get_pending_proposal(db, agent.name)
    except LearningError as exc:
        await db.rollback()
        raise HTTPException(status_code=exc.status_code, detail=exc.message) from exc
    return AgentFeedbackCreated(
        feedback_id=feedback.id,
        experience_id=experience.id,
        evaluation={
            "status": "evaluated",
            "agent": agent.name,
            "metric": evaluation.metric,
            "score": evaluation.score,
            "passed": evaluation.passed,
            "details": evaluation.details,
        },
        proposal=_proposal_read(proposal) if proposal is not None else None,
    )


