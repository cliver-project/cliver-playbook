name: {{ project_slug }}

services:
  db:
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_USER: cliver
      POSTGRES_PASSWORD: cliver
      POSTGRES_DB: {{ project_slug }}
    ports:
      - "127.0.0.1:${DB_PORT:-5432}:5432"
    volumes:
      - {{ project_slug }}_db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U cliver -d {{ project_slug }}"]
      interval: 5s
      timeout: 3s
      retries: 10

{% if enabled('api.python') %}
  api:
    build:
      context: ../..
      dockerfile: infra/docker/api.Dockerfile
    environment:
      CLIVER_DATABASE_URL: postgresql+asyncpg://cliver:cliver@db:5432/{{ project_slug }}
      CLIVER_LOG_LEVEL: INFO
    ports:
      - "127.0.0.1:${API_PORT:-8000}:8000"
    depends_on:
      db:
        condition: service_healthy
{% endif %}

{% if enabled('model.python') %}
  model:
    build:
      context: ../..
      dockerfile: infra/docker/model.Dockerfile
    environment:
      MODEL_CAPABILITIES: ${MODEL_CAPABILITIES:-llm,embedding,rerank,asr,image,tts,video,system_one}
    ports:
      - "127.0.0.1:${MODEL_PORT:-8010}:8010"
{% endif %}

volumes:
  {{ project_slug }}_db:
