        "type": "object",
        "properties": {
          "form_id": {
            "type": "string",
            "description": "Report form id, e.g. GL_RPT_AccountBalance."
          },
          "data": {
            "type": "object",
            "description": "Inner GetSysReportData model object.",
            "additionalProperties": true
          }
        },
        "required": [
          "form_id",
          "data"
        ],
        "additionalProperties": false
      }
    },
